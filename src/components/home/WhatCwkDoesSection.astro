---
const spokes = [
  { id: 'chart', label: 'Analytics',  angle: 180, color: 'cyan'   },
  { id: 'users', label: 'Relationships', angle:   0, color: 'purple' },
  { id: 'calendar', label: 'Cadence', angle: 270, color: 'pink'   },
  { id: 'zap',   label: 'Automation', angle:  90, color: 'cyan'   },
];
---

<section class="section whatcwk-section">
  <div class="wc-inner">
    <!-- Copy -->
    <div class="wc-copy">
      <span class="wc-eyebrow reveal-up">
        <span class="wc-eyebrow-dot"></span>
        WHAT CWK. DOES
      </span>

      <p class="wc-lead reveal-up reveal-delay-1">
        CWK. is the door. And we stay until <span class="wc-lead-em">everything behind it is built.</span>
      </p>

      <p class="wc-sub reveal-up reveal-delay-2">
        We come in, learn your world, and build the structure alongside you.
        Our time, our tools, and our people go in until the business holds its own.
      </p>

      <blockquote class="wc-quote reveal-up reveal-delay-3">
        This is for founders who are done being used and ready for someone who stays.
        For <span class="wc-quote-em">structure, not survival</span>.
      </blockquote>
    </div>
  </div>
</section>

<style>
  .whatcwk-section {
    background: var(--bg);
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .wc-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Copy ─────────────────────────────────────────────────── */
  .wc-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }

  .wc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.22);
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--cyan);
  }
  .wc-eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.55);
  }

  .wc-lead {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 500;
    color: var(--text);
    line-height: 1.45;
    margin: 0;
    letter-spacing: -0.005em;
  }
  .wc-lead-em { font-weight: 700; }

  .wc-sub {
    margin: 0;
    font-size: 16px;
    color: var(--muted);
    line-height: 1.65;
  }

  .wc-quote {
    margin: 4px 0 0;
    padding: 10px 0 10px 20px;
    border-left: 3px solid var(--cyan);
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.5;
    letter-spacing: -0.005em;
    font-style: normal;
    position: relative;
  }
  .wc-quote::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--cyan), var(--purple));
    opacity: 0.8;
  }
  .wc-quote-em {
    background: linear-gradient(135deg, #00E5FF, #7B61FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .whatcwk-section { padding-top: 64px; padding-bottom: 64px; }
    .wc-quote { font-size: 15px; padding-left: 16px; }
  }
</style>
