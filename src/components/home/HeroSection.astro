---
import PortableText from '../PortableText.astro';

interface Props {
  eyebrow: string;
  topline: string;
  phrases: string[];
  headline: string;
  subheadline?: string;
  /** Optional cyan accent line rendered under the main title. */
  headlineAccent?: string;
  /** Optional gradient line rendered under the subheadline. */
  subheadlineAccent?: string;
  ctaLabel: string;
  ctaHref?: string;
  /** When true, the CTA is a button that opens the live chat (ou.chat) instead of a link. */
  ctaChat?: boolean;
  /** Optional small caption shown under the CTA. */
  ctaCaption?: string;
  subtext?: any;
}

const {
  eyebrow,
  topline,
  phrases,
  headline,
  headlineAccent,
  subheadline,
  subheadlineAccent,
  ctaLabel,
  ctaHref = '/assessment',
  ctaChat = false,
  ctaCaption,
  subtext,
} = Astro.props;

const flipPhrases = Array.isArray(phrases) && phrases.length > 0 ? phrases : [];
---

<section class="hero">

  <!-- Animated background layer -->
  <div class="hero-bg" aria-hidden="true">

    <!-- Background video (jungle) — replaces the old network Lottie globe.
         Sits behind the ambient decoration below it in the DOM. -->
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/videos/home-hero/hero-bg-poster.jpg"
    >
      <source src="/videos/home-hero/hero-bg.mp4" type="video/mp4" />
      <source src="/videos/home-hero/hero-bg.webm" type="video/webm" />
    </video>
    <!-- Static poster shown when the visitor prefers reduced motion -->
    <img class="hero-video-poster" src="/videos/home-hero/hero-bg-poster.jpg" alt="" aria-hidden="true" />

    <!-- Ambient glow orbs -->
    <div class="orb orb-cyan"></div>
    <div class="orb orb-purple"></div>
    <div class="orb orb-pink"></div>

    <!-- Light streaks -->
    <div class="streak streak-1"></div>
    <div class="streak streak-2"></div>
    <div class="streak streak-3"></div>

    <!-- Floating glass cards — left side -->
    <div class="float-card fc-1">
      <div class="fc-bar fc-bar--md" style="width:100px"></div>
      <div class="fc-bar fc-bar--sm" style="width:60px"></div>
      <div class="fc-bar fc-bar--md" style="width:120px"></div>
    </div>
    <div class="float-card fc-2">
      <div class="fc-bar fc-bar--sm" style="width:80px"></div>
      <div class="fc-bar fc-bar--md" style="width:110px"></div>
    </div>
    <div class="float-card fc-3">
      <div class="fc-bar fc-bar--md" style="width:90px"></div>
      <div class="fc-bar fc-bar--sm" style="width:50px"></div>
    </div>

    <!-- Floating glass cards — right side -->
    <div class="float-card fc-4">
      <div class="fc-bar fc-bar--md" style="width:120px"></div>
      <div class="fc-bar fc-bar--sm" style="width:70px"></div>
      <div class="fc-bar fc-bar--md" style="width:100px"></div>
    </div>
    <div class="float-card fc-5">
      <div class="fc-bar fc-bar--sm" style="width:90px"></div>
      <div class="fc-bar fc-bar--md" style="width:110px"></div>
    </div>
    <div class="float-card fc-6">
      <div class="fc-bar fc-bar--md" style="width:80px"></div>
      <div class="fc-bar fc-bar--sm" style="width:50px"></div>
    </div>

    <!-- Decorative lines -->
    <div class="deco-line dl-1"></div>
    <div class="deco-line dl-2"></div>
    <div class="deco-line dl-3"></div>
    <div class="deco-line dl-4"></div>

    <!-- Decorative floating icons (CWK icon library, tinted via CSS mask) -->
    <span class="deco-icon di-1" aria-hidden="true"></span>
    <span class="deco-icon di-2" aria-hidden="true"></span>
    <span class="deco-icon di-3" aria-hidden="true"></span>
    <span class="deco-icon di-4" aria-hidden="true"></span>
    <span class="deco-icon di-5" aria-hidden="true"></span>
    <span class="deco-icon di-6" aria-hidden="true"></span>

    <!-- Accent squares -->
    <div class="acc-sq as-1"></div>
    <div class="acc-sq as-2"></div>
    <div class="acc-sq as-3"></div>
  </div>

  <!-- Hero content -->
  <div class="hero-inner">
    <span class="hero-eyebrow fade-up">{eyebrow}</span>

    <!-- Top headline: white topline + accent line.
         A single phrase renders as a static (wrapping) cyan line; two or more
         phrases use the animated word-flip slot machine. -->
    <h1 class="hero-headline fade-up fade-up-delay-1">
      <span class="hl-line hl-white">{topline}</span>
      {flipPhrases.length === 1 && (
        <span class="hl-line hl-cyan">{flipPhrases[0]}</span>
      )}
      {flipPhrases.length > 1 && (
        <span class="hl-line hl-cyan word-flip-wrap" aria-live="polite" aria-atomic="true">
          <span class="word-flip-track" id="word-flip-track">
            {flipPhrases.map((phrase, i) => (
              <span class="word-flip-item" aria-hidden={i !== 0}>{phrase}</span>
            ))}
            <!-- duplicate of first item — enables seamless infinite loop -->
            <span class="word-flip-item word-flip-sentinel" aria-hidden="true">{flipPhrases[0]}</span>
          </span>
        </span>
      )}
    </h1>

    <!-- Lower block: optional title (+ accent line) + subtitle -->
    {headline && (
      <h2 class="hero-title fade-up fade-up-delay-2">
        <span class="ht-line">{headline}</span>
        {headlineAccent && <span class="ht-line ht-accent">{headlineAccent}</span>}
      </h2>
    )}
    {subheadline && (
      <p class="hero-subtitle fade-up fade-up-delay-2">
        <span class="hs-line">{subheadline}</span>
        {subheadlineAccent && (
          <span class="hs-line hs-accent gradient-text">{subheadlineAccent}</span>
        )}
      </p>
    )}
    {subtext && (
      <div class="hero-sub fade-up fade-up-delay-2 pt-hero-sub"><PortableText value={subtext} /></div>
    )}

    <div class="hero-ctas fade-up fade-up-delay-3">
      {ctaChat ? (
        <button type="button" class="btn-hero-primary" data-open-chat>
          <svg class="btn-chat-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          {ctaLabel}
        </button>
      ) : (
        <a href={ctaHref} class="btn-hero-primary">
          {ctaLabel}
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      )}
      {ctaCaption && <span class="hero-cta-caption">{ctaCaption}</span>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 800px;
    display: flex;
    align-items: center;
    padding-top: 144px;
    padding-bottom: 96px;
  }

  /* ── Background layer ─────────────────────────────── */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Glow orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
  }
  .orb-cyan {
    width: 600px; height: 500px;
    left: 3.5%; top: 120px;
    background: radial-gradient(circle, #00E5FF 0%, transparent 70%);
    opacity: 0.07;
    filter: blur(120px);
    animation: orb-breathe 8s ease-in-out infinite;
  }
  .orb-purple {
    width: 500px; height: 400px;
    right: 5%; top: 100px;
    background: radial-gradient(circle, #7B61FF 0%, transparent 70%);
    opacity: 0.06;
    filter: blur(110px);
    animation: orb-breathe 10s ease-in-out infinite 2s;
  }
  .orb-pink {
    width: 300px; height: 250px;
    left: 50%; top: 460px;
    background: radial-gradient(circle, #FB3079 0%, transparent 70%);
    opacity: 0.03;
    filter: blur(80px);
    animation: orb-breathe-cx 12s ease-in-out infinite 4s;
  }
  @keyframes orb-breathe {
    0%, 100% { scale: 1; }
    50%       { scale: 1.08; }
  }
  @keyframes orb-breathe-cx {
    0%, 100% { translate: -50% 0; scale: 1; }
    50%       { translate: -50% 0; scale: 1.1; }
  }

  /* Light streaks */
  .streak {
    position: absolute;
    border-radius: 2px;
  }
  .streak-1 {
    width: 70%; height: 2px;
    left: 7%; top: 200px;
    background: #00E5FF;
    opacity: 0.1; filter: blur(25px);
    rotate: 4deg;
    animation: streak-drift 15s ease-in-out infinite;
  }
  .streak-2 {
    width: 76%; height: 3px;
    left: 14%; top: 400px;
    background: #7B61FF;
    opacity: 0.1; filter: blur(28px);
    rotate: -3deg;
    animation: streak-drift 18s ease-in-out infinite 3s;
  }
  .streak-3 {
    width: 63%; height: 2px;
    left: 10%; top: 550px;
    background: #FB3079;
    opacity: 0.12; filter: blur(22px);
    rotate: 5deg;
    animation: streak-drift 12s ease-in-out infinite 6s;
  }
  @keyframes streak-drift {
    0%, 100% { translate: 0 0; opacity: 0.1; }
    50%       { translate: 0 -20px; opacity: 0.15; }
  }

  /* Floating glass cards */
  .float-card {
    position: absolute;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .fc-bar {
    border-radius: 4px;
    flex-shrink: 0;
  }
  .fc-bar--md { height: 10px; background: rgba(255,255,255,0.14); }
  .fc-bar--sm { height:  8px; background: rgba(255,255,255,0.08); }

  /* Left cards */
  .fc-1 { width: 190px; left: 2.8%;  top: 140px; rotate: 5deg;  animation: card-float  9s ease-in-out infinite; }
  .fc-2 { width: 170px; left: 6.9%;  top: 350px; rotate: -6deg; animation: card-float 11s ease-in-out infinite 1.5s; }
  .fc-3 { width: 160px; left: 1.4%;  top: 530px; rotate: 3deg;  animation: card-float 13s ease-in-out infinite 3s; }
  /* Right cards */
  .fc-4 { width: 170px; right: 13%; top:  50px; rotate: -7deg; animation: card-float 10s ease-in-out infinite 0.8s; }
  .fc-5 { width: 150px; right: 10%; top: 310px; rotate: 5deg;  animation: card-float 8.5s ease-in-out infinite 2.2s; }
  .fc-6 { width: 165px; right: 14%; top: 580px; rotate: -3deg; animation: card-float 12s ease-in-out infinite 4.5s; }
  @keyframes card-float {
    0%, 100% { translate: 0 0; }
    50%       { translate: 0 -14px; }
  }

  /* Decorative lines */
  .deco-line {
    position: absolute;
    height: 0;
    border-top: 1px solid rgba(255,255,255,0.14);
  }
  .dl-1 { width: 120px; left: 13.9%; top: 280px; rotate:  25deg; opacity: 0.5; }
  .dl-2 { width: 100px; left: 10.4%; top: 480px; rotate: -15deg; opacity: 0.4; }
  .dl-3 { width: 110px; right: 9.7%; top: 270px; rotate: -20deg; opacity: 0.5; }
  .dl-4 { width:  90px; right:11.1%; top: 470px; rotate:  18deg; opacity: 0.4; }

  /* Decorative icons — CWK icon-library SVGs used as tintable CSS masks.
     The mask uses each icon's alpha, so background-color sets the tint. */
  .deco-icon {
    position: absolute;
    background-color: currentColor;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .di-1 { -webkit-mask-image: url('/images/hero-icons/icon_rocketship.svg'); mask-image: url('/images/hero-icons/icon_rocketship.svg'); width: 40px; height: 40px; color: #00E5FF; opacity: 0.6;  left: 81.5%; top:  56px; animation: icon-drift 11s ease-in-out infinite; }
  .di-2 { -webkit-mask-image: url('/images/hero-icons/icon_build.svg');      mask-image: url('/images/hero-icons/icon_build.svg');      width: 36px; height: 36px; color: #7B61FF; opacity: 0.5;  left:   17%; top: 300px; animation: icon-drift 13s ease-in-out infinite 2s; }
  .di-3 { -webkit-mask-image: url('/images/hero-icons/icon_power_ups.svg');  mask-image: url('/images/hero-icons/icon_power_ups.svg');  width: 34px; height: 34px; color: #FB3079; opacity: 0.55; left: 80.6%; top: 620px; animation: icon-drift  9s ease-in-out infinite 1s; }
  .di-4 { -webkit-mask-image: url('/images/hero-icons/icon_target.svg');     mask-image: url('/images/hero-icons/icon_target.svg');     width: 32px; height: 32px; color: #00E5FF; opacity: 0.45; left: 18.75%; top: 70px; animation: icon-drift 14s ease-in-out infinite 3s; }
  .di-5 { -webkit-mask-image: url('/images/hero-icons/icon_money_bag.svg');  mask-image: url('/images/hero-icons/icon_money_bag.svg');  width: 36px; height: 36px; color: #7B61FF; opacity: 0.5;  left: 84.5%; top: 420px; animation: icon-drift 12s ease-in-out infinite 4s; }
  .di-6 { -webkit-mask-image: url('/images/hero-icons/icon_operator.svg');   mask-image: url('/images/hero-icons/icon_operator.svg');   width: 36px; height: 36px; color: #00E5FF; opacity: 0.5;  left: 13.5%; top: 540px; animation: icon-drift 10s ease-in-out infinite 2.5s; }
  @keyframes icon-drift {
    0%, 100% { translate: 0 0;    rotate:  0deg; }
    33%       { translate: 4px -8px;  rotate:  5deg; }
    66%       { translate: -4px -4px; rotate: -3deg; }
  }

  /* Accent squares */
  .acc-sq {
    position: absolute;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
  }
  .as-1 { width:34px; height:34px; left:19.4%; top:180px; border-radius:7px; opacity:0.45; rotate: 15deg; animation: acc-drift 16s ease-in-out infinite; }
  .as-2 { width:38px; height:38px; left:79.9%; top:500px; border-radius:8px; opacity:0.4;  rotate:-12deg; animation: acc-drift 12s ease-in-out infinite 3s; }
  .as-3 { width:30px; height:30px; left:17.4%; top:600px; border-radius:6px; opacity:0.5;  rotate: 22deg; animation: acc-drift 18s ease-in-out infinite 6s; }
  @keyframes acc-drift {
    0%, 100% { translate: 0 0; }
    25%       { translate:  5px -10px; }
    75%       { translate: -5px  -5px; }
  }

  /* ── Background video layer ────────────────────────── */
  /* Full-bleed jungle clip behind the hero content. Sits first in the DOM so
     the ambient orbs / floating cards / decoration paint on top of it. The
     clip's center is near-black, so the white headline + CTA stay legible. */
  .hero-video,
  .hero-video-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  /* Poster only shows for reduced-motion visitors (video is hidden then). */
  .hero-video-poster { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
    .hero-video-poster { display: block; }
  }

  /* ── Hero content ──────────────────────────────────── */
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 860px;
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Eyebrow */
  .hero-eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #00E5FF;
    margin-bottom: 24px;
  }

  /* Headline */
  .hero-headline {
    font-size: clamp(30px, 6.2vw, 72px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 32px;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .hl-line  { display: block; }
  .hl-white { color: var(--text); }
  .hl-cyan  { color: #00E5FF; }

  /* ── Word-flip slot machine ────────────────────────── */
  .word-flip-wrap {
    display: inline-block;
    overflow: hidden;
    height: 1.2em;
    clip-path: inset(0 0 0 0);
    vertical-align: bottom;
    position: relative;
    padding: 0.05em 0;
    margin: 0.06em 0;
  }
  .word-flip-track {
    display: flex;
    flex-direction: column;
    will-change: transform;
  }
  .word-flip-item {
    display: block;
    line-height: 1.2em;
    height: 1.2em;
    overflow: hidden;
    white-space: nowrap;
  }
  .word-flip-track.is-animating {
    transition: transform 0.52s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .word-flip-track.no-transition {
    transition: none;
  }

  /* Lower block — secondary title + subtitle */
  .hero-title {
    margin: 8px 0 10px;
    max-width: 760px;
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .hero-title .ht-line { display: block; }
  .hero-title .ht-accent { color: var(--cyan); }
  .hero-subtitle {
    margin: 0 0 28px;
    max-width: 640px;
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 500;
    line-height: 1.55;
    color: var(--muted);
  }
  .hero-subtitle .hs-line { display: block; }
  /* Gradient closing line (uses the global .gradient-text treatment) */
  .hero-subtitle .hs-accent { font-weight: 700; }

  /* Optional rich-text subtext (Sanity-driven) */
  .hero-sub {
    max-width: 640px;
    margin: 0 0 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    text-align: center;
    font-size: clamp(17px, 1.8vw, 20px);
    color: rgba(255, 255, 255, 0.86);
    line-height: 1.5;
  }

  /* CTA area */
  .hero-ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  /* Primary CTA — assessment */
  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: linear-gradient(180deg, #00E5FF 0%, #00B4D8 100%);
    color: #07090F;
    border: none;
    border-radius: 10px;
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 24px rgba(0, 229, 255, 0.30);
    transition: box-shadow 0.3s ease, filter 0.2s ease, transform 0.1s ease;
  }
  .btn-hero-primary:hover {
    filter: brightness(1.06);
    box-shadow: 0 6px 32px rgba(0, 229, 255, 0.45);
  }
  .btn-hero-primary:active { transform: scale(0.98); }
  .btn-arrow, .btn-chat-icon { flex-shrink: 0; }

  /* Small caption under the CTA (e.g. "24/7 Front Desk") */
  .hero-cta-caption {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    /* Hide right-side background cards on mid-size screens */
    .fc-4, .fc-5, .fc-6, .dl-3, .dl-4, .di-1, .di-3, .di-5, .as-2 { display: none; }
  }
  @media (max-width: 768px) {
    /* Hide all background decoration on mobile */
    .float-card, .deco-line, .deco-icon, .acc-sq, .streak { display: none; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 112px; min-height: auto; }
    .btn-hero-primary { width: 100%; max-width: 360px; justify-content: center; }
  }
</style>

<script>
  // Word-flip slot machine — cycles the cyan word in the top headline.
  (() => {
    const INTERVAL = 1600; // ms between flips
    const track = document.getElementById('word-flip-track') as HTMLElement | null;
    if (!track) return;

    const allItems = Array.from(track.querySelectorAll<HTMLElement>('.word-flip-item'));
    const real  = allItems.filter(el => !el.classList.contains('word-flip-sentinel'));
    const total = real.length;
    if (total < 2) return;

    let current = 0;
    track.style.transform = 'translateY(0)';

    function advance() {
      const visualNext = current + 1;
      track!.classList.add('is-animating');
      track!.style.transform = `translateY(-${visualNext * 1.2}em)`;
      real[current % total].setAttribute('aria-hidden', 'true');
      real[visualNext % total].setAttribute('aria-hidden', 'false');

      if (visualNext === total) {
        track!.addEventListener('transitionend', () => {
          track!.classList.remove('is-animating');
          track!.classList.add('no-transition');
          track!.style.transform = 'translateY(0)';
          void (track!.offsetHeight);
          track!.classList.remove('no-transition');
          current = 0;
        }, { once: true });
      } else {
        current = visualNext;
      }
    }

    setTimeout(() => { setInterval(advance, INTERVAL); }, INTERVAL);
  })();
</script>

<!--
  The [data-open-chat] click binding used to live here. It now runs site-wide in
  Base.astro: scoped to this component it only existed on the homepage, so the
  same attribute silently did nothing on every other page that used it.
-->
