---
// Logo-only header for focused landing pages (/business-support and its stage
// pages).
//
// Those pages ship no navigation on purpose: the only ways off the page are
// this logo and the options the page itself puts in front of the visitor. It
// carried a booking CTA for a while; that came out because the booking belongs
// on its own row, where the calendar opens underneath it. See issue #240
// before adding anything here.
---

<header class="focus-header">
  <div class="focus-inner">
    <a href="/" class="focus-logo" aria-label="CWK. Experience: Home">
      <img
        src="/logos/logo-main-negative-CWK.svg"
        alt="CWK."
        width="74"
        height="28"
        loading="eager"
        decoding="async"
      />
    </a>
  </div>
</header>

<style>
  .focus-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    height: 64px;
    background: rgba(7, 9, 15, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--gb);
  }

  .focus-inner {
    display: flex;
    align-items: center;
    height: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .focus-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    /* The logo is the only way home from these pages, so its hit area is
       padded to a comfortable 44px and pulled back out with a negative
       margin so the header layout is unchanged. */
    padding: 8px;
    margin-left: -8px;
    transition: opacity 0.2s ease;
  }
  .focus-logo:hover { opacity: 0.75; }
  .focus-logo:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
    border-radius: 8px;
  }
  .focus-logo img { display: block; }

  @media (max-width: 640px) {
    .focus-inner { padding: 0 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .focus-logo { transition: none; }
  }
</style>
