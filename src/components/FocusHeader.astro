---
// Logo-only header for focused landing pages (/business-support and its stage
// pages), with one optional CTA on the right.
//
// Those pages ship no navigation on purpose: the only ways off the page are
// this logo and the options the page itself puts in front of the visitor. The
// CTA is one of those options, not a nav link. See issue #240.
export interface FocusCta {
  href: string;
  label: string;
  /** Shown instead of `label` on narrow screens. */
  shortLabel?: string;
  /** Small qualifier pill beside the label, e.g. "Free, 20 min". */
  note?: string;
  /**
   * Marks the CTA for a page script to intercept. On the stage pages the
   * booking panel script picks this up and expands the inline calendar
   * instead of following the link; anywhere else the href still works.
   */
  openBooking?: boolean;
}

interface Props {
  cta?: FocusCta | null;
}
const { cta = null } = Astro.props;
---

<header class="focus-header">
  <div class="focus-inner">
    <a href="/" class="focus-logo" aria-label="CWK. Experience: Home">
      <img
        src="/logos/logo-main-negative-CWK.svg"
        alt="CWK."
        width="74"
        height="28"
        loading="eager"
        decoding="async"
      />
    </a>

    {cta && (
      <a
        class="focus-cta"
        href={cta.href}
        data-open-booking={cta.openBooking ? '' : undefined}
        data-track-event="focus_header_cta_clicked"
      >
        <svg class="focus-cta-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2.5" />
          <path d="M3 10h18M8 3v4M16 3v4" stroke-linecap="round" />
        </svg>
        <span class="focus-cta-label">
          {cta.shortLabel
            ? (<><span class="focus-cta-long">{cta.label}</span><span class="focus-cta-short">{cta.shortLabel}</span></>)
            : cta.label}
        </span>
        {cta.note && <span class="focus-cta-note">{cta.note}</span>}
      </a>
    )}
  </div>
</header>

<style>
  .focus-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    height: 64px;
    background: rgba(7, 9, 15, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--gb);
  }

  .focus-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .focus-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    /* The logo is the only way home from these pages, so its hit area is
       padded to a comfortable 44px and pulled back out with a negative
       margin so the header layout is unchanged. */
    padding: 8px;
    margin-left: -8px;
    transition: opacity 0.2s ease;
  }
  .focus-logo:hover { opacity: 0.75; }
  .focus-logo:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
    border-radius: 8px;
  }
  .focus-logo img { display: block; }

  /* ── CTA ──────────────────────────────────────────────────
     Cyan on every stage rather than the page's own accent: the
     header is the one element shared across all four pages, so a
     colour that shifts underneath the visitor would read as a
     different button. */
  .focus-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    background: var(--cyan);
    color: var(--bg);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  @media (hover: hover) {
    .focus-cta:hover { filter: brightness(1.08); color: var(--bg); }
  }
  .focus-cta:active { transform: scale(0.98); }
  .focus-cta:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .focus-cta-ic { width: 16px; height: 16px; flex-shrink: 0; }

  .focus-cta-short { display: none; }

  .focus-cta-note {
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: rgba(7, 9, 15, 0.16);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  @media (max-width: 860px) {
    .focus-cta-long { display: none; }
    .focus-cta-short { display: inline; }
  }

  @media (max-width: 640px) {
    .focus-inner { padding: 0 16px; gap: 10px; }
    .focus-cta {
      gap: 7px;
      padding: 8px 12px;
      font-size: 13px;
    }
    .focus-cta-ic { width: 15px; height: 15px; }
    .focus-cta-note { padding: 3px 7px; font-size: 11px; }
  }

  /* Below this the icon plus both labels stop fitting next to the logo. The
     qualifier goes first, since the CTA text carries the meaning. */
  @media (max-width: 380px) {
    .focus-cta-note { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .focus-cta, .focus-logo { transition: none; }
  }
</style>
