---
// Poster frame for a video slot.
//
// No footage ships with the design handoff, so with `embedUrl` unset this
// renders a labelled placeholder: a tinted 16/9 frame, a decorative play
// glyph, and a caption saying what belongs here. Nothing is focusable,
// because there is nothing to play yet.
//
// When a real embed lands, pass `embedUrl`. The frame then renders a real
// <button> that swaps itself for the iframe on click: click-to-play, lazy
// loaded, never autoplaying with sound.
import type { Accent } from '../../data/frontDesk';

interface Props {
  size: 'lg' | 'sm';
  /** Tints the frame and the small play glyph. */
  accent?: Accent;
  /** Duration chip, top right on lg frames, bottom right on sm. */
  time?: string;
  /** Tag pill, top left. Pass the class, e.g. "tag" or "tag-pink". */
  tagText?: string;
  tagClass?: string;
  caption?: string;
  embedUrl?: string | null;
  label?: string;
}

const {
  size,
  accent = 'cyan',
  time,
  tagText,
  tagClass = 'tag',
  caption,
  embedUrl = null,
  label = 'Play the video',
} = Astro.props;

const playAccent = size === 'sm' && accent !== 'cyan' ? ` fd-play--${accent}` : '';
---

<figure class:list={['vf', `vf--${size}`]}>
  <div class:list={['vf-frame', `vf-frame--${accent}`]}>
    {tagText && <span class:list={['tag', tagClass, 'vf-tag']}>{tagText}</span>}
    {time && <span class="fd-timechip vf-time">{time}</span>}

    {embedUrl ? (
      <button type="button" class="vf-btn" data-video-embed={embedUrl} aria-label={label}>
        <span class={`fd-play fd-play--${size}${playAccent}`} aria-hidden="true"></span>
      </button>
    ) : (
      <span class={`fd-play fd-play--${size}${playAccent}`} aria-hidden="true"></span>
    )}
  </div>
  {caption && <figcaption class="vf-caption">{caption}</figcaption>}
</figure>

<style>
  .vf { margin: 0; }

  .vf-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background:
      radial-gradient(110% 110% at 26% 18%, rgba(0, 229, 255, 0.2), transparent 60%),
      radial-gradient(90% 90% at 84% 92%, rgba(123, 97, 255, 0.24), transparent 62%),
      linear-gradient(180deg, var(--bg3), var(--bg));
  }
  .vf--lg .vf-frame {
    border: 1px solid var(--gb2);
    border-radius: 18px;
    box-shadow: 0 34px 90px rgba(0, 0, 0, 0.6);
  }
  .vf--sm .vf-frame { border-radius: 10px; }

  /* Grid wash over the poster, 44px on the big frame only. */
  .vf--lg .vf-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 44px 44px;
  }

  .vf-frame--purple {
    background:
      radial-gradient(90% 90% at 30% 20%, rgba(123, 97, 255, 0.18), transparent 62%),
      linear-gradient(180deg, var(--bg3), var(--bg));
  }
  .vf-frame--green {
    background:
      radial-gradient(90% 90% at 30% 20%, rgba(0, 227, 150, 0.16), transparent 62%),
      linear-gradient(180deg, var(--bg3), var(--bg));
  }

  .vf-tag { position: absolute; top: 16px; left: 16px; z-index: 1; }
  .vf--sm .vf-tag { top: 8px; left: 8px; }

  .vf-time { position: absolute; z-index: 1; }
  .vf--lg .vf-time { top: 16px; right: 16px; }
  .vf--sm .vf-time { right: 8px; bottom: 8px; padding: 3px 8px; font-size: 11px; }

  .vf-btn {
    position: absolute;
    inset: 0;
    z-index: 1;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
  }
  .vf-btn:focus-visible { outline: none; box-shadow: var(--fd-glow-ring); }

  .vf-caption {
    margin-top: 12px;
    text-align: center;
    font-size: 12px;
    color: var(--dim);
  }
</style>
