---
import { truth, beliefs } from '../../data/frontDesk';
---

<section class="truth fd-section" id="story">
  <div class="fd-container truth-grid">
    <div>
      <span class="fd-eyebrow reveal-up">{truth.eyebrow}</span>
      <h2 class="fd-h2 fd-h2--lg truth-title reveal-up reveal-delay-1">{truth.title}</h2>
      <p class="fd-lede reveal-up reveal-delay-2">{truth.lede}</p>
      <p class="fd-lede fd-lede--strong reveal-up reveal-delay-3">{truth.ledeStrong}</p>
    </div>

    <div class="truth-beliefs">
      {beliefs.map((b, i) => (
        <article class={`truth-belief truth-belief--${b.accent} reveal-card`} style={`--reveal-i:${i}`}>
          <h3 class="truth-belief-title">{b.title}</h3>
          <p class="truth-belief-body">{b.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .truth {
    background: radial-gradient(70% 60% at 80% 10%, rgba(123, 97, 255, 0.14), transparent 60%);
  }
  .truth-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(28px, 4vw, 56px);
  }
  .truth-title { line-height: 1.04; }

  .truth-beliefs { display: grid; gap: 16px; align-content: start; }
  .truth-belief {
    padding: 22px;
    border: 1px solid var(--gb);
    border-left-width: 2px;
    border-radius: 14px;
    background: var(--bg2);
  }
  .truth-belief--cyan   { border-left-color: var(--cyan); }
  .truth-belief--purple { border-left-color: var(--purple); }
  .truth-belief--pink   { border-left-color: var(--pink); }
  .truth-belief-title { margin: 0; font-size: 17px; font-weight: 700; color: var(--text); }
  .truth-belief-body { margin: 8px 0 0; font-size: 15px; line-height: 1.55; color: var(--muted); }

  @media (max-width: 1024px) {
    .truth-grid { grid-template-columns: 1fr; }
  }
</style>
