---
import VideoFrame from './VideoFrame.astro';
import { tour, chapters } from '../../data/frontDesk';
---

<section class="fd-section fd-section--alt fd-hair-y" id="tour">
  <div class="fd-container">
    <div class="fd-head fd-head--center">
      <span class="fd-eyebrow fd-eyebrow--cyan reveal-up">{tour.eyebrow}</span>
      <h2 class="fd-h2 reveal-up reveal-delay-1">{tour.title}</h2>
      <p class="fd-lede reveal-up reveal-delay-2">{tour.lede}</p>
    </div>

    <div class="promo-player reveal-card">
      <VideoFrame
        size="lg"
        time={tour.duration}
        tagText={tour.tag}
        tagClass="tag"
        caption={tour.caption}
        embedUrl={tour.embedUrl}
        label="Play the two-minute tour"
      />
    </div>

    <div class="promo-chapters">
      {chapters.map((c, i) => (
        <article class="promo-chapter reveal-card" style={`--reveal-i:${i}`}>
          <VideoFrame
            size="sm"
            accent={c.accent}
            time={c.time}
            embedUrl={c.embedUrl}
            label={`Play the clip: ${c.title}`}
          />
          <h3 class="promo-chapter-title">{c.title}</h3>
          <p class="promo-chapter-body">{c.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .promo-player { max-width: 960px; margin: 34px auto 0; }

  .promo-chapters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 960px;
    margin: 30px auto 0;
  }
  .promo-chapter {
    border: 1px solid var(--gb);
    border-radius: 14px;
    background: var(--bg);
    padding: 14px;
    transition: border-color var(--fd-motion) var(--fd-ease);
  }
  .promo-chapter:hover { border-color: var(--gb2); }
  .promo-chapter-title { margin: 12px 0 0; font-size: 15px; font-weight: 700; color: var(--text); }
  .promo-chapter-body { margin: 4px 0 0; font-size: 13px; line-height: 1.5; color: var(--muted); }

  @media (max-width: 820px) {
    .promo-chapters { grid-template-columns: 1fr; }
  }
</style>
