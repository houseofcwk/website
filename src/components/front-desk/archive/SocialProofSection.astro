---
import StatGrid from './StatGrid.astro';
import { proof, flags } from '../../data/frontDesk';

// Two treatments, switched by flags.proofStrip. `logos` is the default.
// The plate list renders twice so the marquee's -50% translate wraps seamlessly.
const plates = Array.from({ length: proof.plateCount }, (_, i) => i);
const passes = [0, 1];
---

<section class="proof fd-hair-b" id="proof">
  <div class="fd-container">
    {flags.proofStrip === 'logos' ? (
      <>
        <p class="proof-label">{proof.label}</p>
        <div class="proof-logos">
          <div class="fd-marquee-track proof-track">
            {passes.map(() => (
              <>
                {plates.map(() => (
                  <span class="proof-plate">CLIENT LOGO</span>
                ))}
              </>
            ))}
          </div>
        </div>
      </>
    ) : (
      <StatGrid items={proof.metrics} cols={4} />
    )}
  </div>
</section>

<style>
  .proof { padding-block: clamp(34px, 4vw, 48px); }

  .proof-label {
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 22px;
  }

  .proof-logos {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .proof-track { gap: 14px; }

  /* Placeholder plates. Swap for monochrome client SVGs at ~24-28px optical height. */
  .proof-plate {
    display: grid;
    place-items: center;
    width: 190px;
    height: 68px;
    flex-shrink: 0;
    border: 1px solid var(--gb);
    border-radius: 12px;
    background: var(--bg2);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--dim);
  }
</style>
