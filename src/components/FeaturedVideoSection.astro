---
// Featured video block on the home page. Sits between the product preview
// and the Player X-Ray CTA. Uses a click-to-play facade so the YouTube
// custom thumbnail never renders — the iframe only mounts on activation.
const videoId = 'S5t5Z9uobOc';
const videoSrc = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1&autoplay=1`;
const coverSrc = '/images/home/featured-video-cover.webp';
---

<section class="fv-section">
  <span class="fv-glow" aria-hidden="true"></span>

  <div class="fv-inner">
    <header class="fv-head reveal-up">
      <span class="fv-eyebrow">
        <span class="fv-eyebrow-dot" aria-hidden="true"></span>
        Watch
      </span>
      <h2 class="fv-headline">Hear it straight from Kris, Founder of CWK.</h2>
      <p class="fv-sub">
        3 years. 53 case studies. Here is what we built and why it matters.
      </p>
    </header>

    <figure class="fv-figure reveal-card">
      <div
        class="fv-frame"
        data-fv-frame
        data-fv-src={videoSrc}
      >
        <img
          src={coverSrc}
          alt=""
          aria-hidden="true"
          class="fv-cover"
          loading="lazy"
          decoding="async"
          width="1280"
          height="720"
        />
        <button type="button" class="fv-play" aria-label="Play video">
          <svg class="fv-play-icon" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v13.72a1 1 0 0 0 1.55.83l10.79-6.86a1 1 0 0 0 0-1.66L9.55 4.31A1 1 0 0 0 8 5.14Z"/>
          </svg>
        </button>
      </div>
      <figcaption class="fv-caption">
        Kris on building CWK, the players we rep, and what long-term partnership actually looks like.
      </figcaption>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-fv-frame]').forEach((frame) => {
    const button = frame.querySelector<HTMLButtonElement>('.fv-play');
    const src = frame.dataset.fvSrc;
    if (!button || !src) return;

    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'CWK feature video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      // Sizing inline — Astro's scoped `.fv-frame iframe` rule won't match
      // an element created at runtime (no data-astro-cid-* attribute).
      iframe.style.cssText =
        'position:absolute;inset:0;width:100%;height:100%;border:0;display:block;';
      frame.replaceChildren(iframe);
    }, { once: true });
  });
</script>

<style>
  .fv-section {
    position: relative;
    background: var(--bg);
    overflow: hidden;
    padding: 96px 24px 80px;
  }

  .fv-glow {
    position: absolute;
    top: 12%;
    left: 50%;
    width: 900px;
    height: 460px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse,
      rgba(123, 97, 255, 0.06) 0%,
      rgba(0, 229, 255, 0.035) 55%,
      transparent 75%
    );
    filter: blur(8px);
    pointer-events: none;
    z-index: 0;
  }

  .fv-inner {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
    align-items: center;
  }

  .fv-head {
    text-align: center;
    max-width: 720px;
  }

  .fv-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.28);
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #4ADE80;
    margin-bottom: 18px;
  }
  .fv-eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #22C55E;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.55);
  }

  .fv-headline {
    margin: 0 0 14px;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .fv-sub {
    color: var(--muted);
    max-width: 580px;
    margin: 0 auto;
    font-size: clamp(14.5px, 1.5vw, 16px);
    line-height: 1.6;
  }

  .fv-figure {
    width: 100%;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--gb);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(123, 97, 255, 0.08);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.6s ease;
  }

  .fv-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(123, 97, 255, 0.10) 0%, transparent 60%),
      #000;
  }
  .fv-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .fv-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    pointer-events: none;
  }

  .fv-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 84px;
    height: 84px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #00E5FF 0%, #7B61FF 100%);
    color: #07090F;
    cursor: pointer;
    box-shadow:
      0 12px 40px rgba(0, 229, 255, 0.30),
      0 0 0 1px rgba(255, 255, 255, 0.10) inset;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, filter 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .fv-play-icon {
    margin-left: 4px;
  }
  @media (hover: hover) {
    .fv-play:hover {
      transform: scale(1.06);
      filter: brightness(1.06);
      box-shadow:
        0 18px 52px rgba(123, 97, 255, 0.40),
        0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    }
  }
  .fv-play:active { transform: scale(0.97); }
  .fv-play:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 4px;
  }

  .fv-caption {
    padding: 14px 18px;
    font-size: 13px;
    color: var(--dim);
    border-top: 1px solid var(--gb);
    background: var(--bg2);
    line-height: 1.55;
  }

  @media (hover: hover) {
    .fv-figure:hover {
      transform: translateY(-4px);
      box-shadow:
        0 40px 100px rgba(0, 0, 0, 0.55),
        0 0 0 1px rgba(123, 97, 255, 0.16);
    }
  }

  @media (max-width: 640px) {
    .fv-section { padding: 64px 18px 56px; }
    .fv-figure { border-radius: 12px; }
    .fv-caption { padding: 12px 14px; font-size: 12.5px; }
    .fv-play { width: 68px; height: 68px; }
    .fv-play-icon { width: 24px; height: 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fv-figure,
    .fv-play { transition: none; }
  }
</style>
