---
import Base from '../layouts/Base.astro';

const pageTitle = 'Your account | CWK. Experience';
const pageDescription = 'Manage your CWK account and purchases.';
---

<Base title={pageTitle} description={pageDescription}>
  <section class="acct">
    <span class="acct-eyebrow">ACCOUNT</span>
    <h1 class="acct-h1">Your account</h1>

    <div class="acct-card" id="acct-card">
      <p class="acct-loading" id="acct-loading">Loading…</p>
    </div>
  </section>
</Base>

<script>
  import { me, logout } from '../lib/plosAuth';
  import { getFeatures } from '../lib/plosEntitlements';

  const FEATURE_LABELS: Record<string, { name: string; href: string; cta: string }> = {
    'lifestyle-calculator': {
      name: 'Lifestyle Calculator',
      href: '/lifestyle-calculator',
      cta: 'Open my map →',
    },
  };

  function esc(s: string): string {
    return s.replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c] as string));
  }

  (async () => {
    const card = document.getElementById('acct-card');
    if (!card) return;

    const auth = await me();
    if (!auth.authenticated || !auth.user) {
      window.location.replace(`/login?return=${encodeURIComponent('/account')}`);
      return;
    }

    const email = auth.user.email;
    const initial = (auth.user.name || email || '?').trim().charAt(0).toUpperCase();
    const features = await getFeatures();

    const purchasesHtml = features.length
      ? `<ul class="acct-purchases">${features
          .map((f) => {
            const meta = FEATURE_LABELS[f];
            const name = meta ? meta.name : f;
            const action = meta
              ? `<a class="acct-open" href="${meta.href}">${meta.cta}</a>`
              : '';
            return `<li class="acct-purchase">
              <div class="acct-purchase-main">
                <span class="acct-purchase-dot"></span>
                <div>
                  <div class="acct-purchase-name">${esc(name)}</div>
                  <div class="acct-purchase-meta">Unlimited access · one-time purchase</div>
                </div>
              </div>
              ${action}
            </li>`;
          })
          .join('')}</ul>`
      : `<div class="acct-empty">
          <p class="acct-empty-text">No purchases yet.</p>
          <a class="acct-unlock" href="/lifestyle-calculator/unlock">Unlock the Lifestyle Calculator →</a>
        </div>`;

    card.innerHTML = `
      <div class="acct-identity">
        <div class="acct-avatar">${esc(initial)}</div>
        <div>
          <div class="acct-id-label">Signed in as</div>
          <div class="acct-email">${esc(email)}</div>
        </div>
      </div>
      <div class="acct-divider"></div>
      <div class="acct-section">
        <div class="acct-section-label">Purchases</div>
        ${purchasesHtml}
      </div>
      <div class="acct-divider"></div>
      <button type="button" class="acct-logout" id="acct-logout">Log out</button>`;

    document.getElementById('acct-logout')?.addEventListener('click', async () => {
      await logout();
      window.location.assign('/');
    });
  })();
</script>

<style>
  .acct {
    max-width: 620px;
    margin: 0 auto;
    padding: 128px 20px 96px;
    color: #EEF0FF;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  @media (max-width: 600px) { .acct { padding: 96px 18px 72px; } }

  .acct-eyebrow { display: block; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #00E5FF; margin-bottom: 10px; }
  .acct-h1 { margin: 0 0 28px; font-size: clamp(28px, 5vw, 34px); font-weight: 800; letter-spacing: -0.6px; }

  .acct-card { border: 1px solid rgba(0, 229, 255, 0.16); border-radius: 16px; background: #0B0E18; padding: 28px 28px; }
  .acct-loading { margin: 0; color: #A8A29E; }

  .acct-identity { display: flex; align-items: center; gap: 16px; }
  .acct-avatar {
    width: 52px; height: 52px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #00E5FF, #7B61FF); color: #07090F;
    font-size: 20px; font-weight: 800; flex-shrink: 0;
  }
  .acct-id-label { font-size: 12px; color: #8A8784; margin-bottom: 3px; }
  .acct-email { font-size: 17px; font-weight: 600; }

  .acct-divider { height: 1px; background: rgba(255, 255, 255, 0.07); margin: 24px 0; }

  .acct-section-label { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #00E5FF; margin-bottom: 14px; }

  .acct-purchases { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .acct-purchase {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 14px 16px; border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
  }
  .acct-purchase-main { display: flex; align-items: center; gap: 12px; }
  .acct-purchase-dot { width: 8px; height: 8px; border-radius: 50%; background: #00E396; flex-shrink: 0; box-shadow: 0 0 10px rgba(0, 227, 150, 0.5); }
  .acct-purchase-name { font-size: 15px; font-weight: 600; }
  .acct-purchase-meta { font-size: 12.5px; color: #8A8784; margin-top: 2px; }
  .acct-open { flex-shrink: 0; font-size: 13px; font-weight: 600; color: #00E5FF; text-decoration: none; white-space: nowrap; }
  .acct-open:hover { text-decoration: underline; }

  .acct-empty { text-align: left; }
  .acct-empty-text { margin: 0 0 14px; font-size: 14px; color: #A8A29E; }
  .acct-unlock {
    display: inline-block; font-size: 14px; font-weight: 700; text-decoration: none;
    color: #07090F; background: linear-gradient(90deg, #00E5FF, #7B61FF);
    padding: 11px 20px; border-radius: 9px;
  }
  .acct-unlock:hover { opacity: 0.92; }

  .acct-logout {
    background: transparent; color: #EEF0FF; border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9px; padding: 11px 20px; font-weight: 600; font-size: 13px; cursor: pointer;
    transition: background 0.15s ease;
  }
  .acct-logout:hover { background: rgba(255, 255, 255, 0.06); }
</style>
