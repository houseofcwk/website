  .fd-give--stress .fd-give-title { color: var(--cyan); }
  .fd-give--time   .fd-give-title { color: var(--orange); }
  .fd-give-body { font-size: 14.5px; line-height: 1.6; color: var(--muted); margin: 0; }

  /* ── Steps ────────────────────────────────────────────── */
  .fd-steps { display: flex; flex-direction: column; gap: var(--gap-tile); margin-top: 20px; }
  .fd-step {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px 24px;
    border-radius: var(--radius-card);
    background: var(--glass);
    border: 1px solid var(--gb);
