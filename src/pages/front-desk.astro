---
import Base from '../layouts/Base.astro';

const pageTitle = 'The Front Desk | CWK. Experience';
const pageDescription =
  'The front desk and receptionist your business never had. People book and buy on their own time, 24/7, and every new lead gets met and pointed the right way, day or night.';

// Primary CTA. FLAG FOR KRIS: this points at /contact until the deposit
// payment link exists. Swap DEPOSIT_HREF for the Stripe (or equivalent)
// checkout URL and nothing else on the page has to change.
const DEPOSIT_HREF = '/contact';
// Canonical Experience Tour link, same target as ExperienceTourSection.astro.
const TOUR_HREF = 'https://calendly.com/cwkexperience/experience-tour';

const DEPOSIT_AMOUNT = '$1,000';

// Offer bar. Seasonal, so it lives in one place: change it here, it changes
// in the hero bar and the final CTA together.
const offer = {
  bonus: '3 months of maintenance free',
  note: `${DEPOSIT_AMOUNT} deposit holds your onboarding call this week`,
  season: 'Pricing and bonuses change with the season',
};

const people = [
  { icon: '🎓', title: 'Teachers and coaches', note: 'Lessons and packs' },
  { icon: '🤝', title: 'Community builders', note: 'Gatherings and sign ups' },
  { icon: '🏪', title: 'Corner shops', note: 'A counter that never closes' },
  { icon: '🚐', title: 'Mobile and delivery', note: 'Orders and drop offs' },
  { icon: '🌙', title: 'Side hustles', note: 'Runs while you work' },
];

const withoutItems = [
  'Calls and texts pile up while you work.',
  'People leave when no one answers fast.',
  'You chase payments after the job is done.',
  'Your nights off are not really off.',
];
const withItems = [
  'People book and buy themselves, day and night.',
  'Every lead gets a warm answer in seconds.',
  'You get paid up front, before you start.',
  'Your time goes back to the work you love.',
];

const frontDeskPoints = [
  { icon: '📅', text: 'Pick a time and book in seconds' },
  { icon: '💳', text: 'Pay up front, or buy a multi-pack' },
  { icon: '🔁', text: 'Rebook with one tap, come back again' },
];
const receptionistPoints = [
  { icon: '👋🏾', text: 'Greets every new lead in seconds' },
  { icon: '🧭', text: 'Routes them to the right service or answer' },
  { icon: '🙌🏾', text: 'Hands you only the people who need you' },
];

// Illustrative numbers for the insights mock. Labelled as an example on the
// card itself so nobody reads them as a real client result.
const insightStats = [
  { value: '18', label: 'Booked this week' },
  { value: '4', label: 'Packs sold' },
  { value: '11', label: 'Answered after hours' },
];

const gives = [
  { key: 'money', title: 'More money', body: 'You are paid the moment someone books, and the easy upsell to a pack happens on its own.' },
  { key: 'stress', title: 'Less stress', body: 'No missed calls. No late night messages. The front desk and the receptionist never clock out.' },
  { key: 'time', title: 'Time back', body: 'The busywork runs itself, so your hours go to the work you actually want to do.' },
];

const steps = [
  { icon: '💳', title: 'Deposit', body: `Pay ${DEPOSIT_AMOUNT}. You skip the line and we book your onboarding this week.` },
  { icon: '🗣️', title: 'Onboarding', body: 'You talk. We pull your business logic into the system. This is the fun part.' },
  { icon: '🛠️', title: 'Build', body: 'We install your Front Desk. You do nothing.' },
  { icon: '⚡', title: 'Live', body: `It goes to work. ${offer.bonus.charAt(0).toUpperCase()}${offer.bonus.slice(1)}.` },
];
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical="https://cwkexperience.com/front-desk"
>
  <div class="fd">

    <!-- ══ HERO ══════════════════════════════════════════════ -->
    <section class="fd-hero" data-section-view="front_desk_hero">
      <div class="fd-hero-glow" aria-hidden="true"></div>
      <div class="fd-wrap fd-hero-inner">

        <!-- Offer bar. Static by design: the brand voice is calm authority,
             so this states the offer once instead of scrolling it. -->
        <div class="fd-offer fade-up">
          <span class="fd-offer-item fd-offer-item--bonus">
            <span class="fd-dot-green" aria-hidden="true"></span>
            Bonus active: <b>{offer.bonus}</b>
          </span>
          <span class="fd-offer-sep" aria-hidden="true"></span>
          <span class="fd-offer-item">{offer.note}</span>
          <span class="fd-offer-sep fd-offer-sep--last" aria-hidden="true"></span>
          <span class="fd-offer-item fd-offer-item--season">{offer.season}</span>
        </div>

        <span class="fd-open-badge fade-up fade-up-delay-1">
          <span class="fd-dot-green" aria-hidden="true"></span>
          OPEN 24 / 7
        </span>

        <h1 class="fd-hero-title fade-up fade-up-delay-2">
          Your first impression happens
          <span class="fd-hero-grad">before they meet you.</span>
        </h1>

        <p class="fd-hero-sub fade-up fade-up-delay-3">
          The front desk and receptionist your business never had. People book and buy
          on their own time, and every new lead gets met and pointed the right way.
          <b>Day or night.</b>
        </p>

        <!-- ── The gap diagram ──────────────────────────────── -->
        <div class="fd-flow fade-up fade-up-delay-4">
          <svg
            class="fd-flow-svg"
            viewBox="0 0 820 300"
            role="img"
            aria-label="A visitor asks a question. At the gap they either leave because no one answers, or they buy because the Front Desk answers."
          >
            <defs>
              <marker id="fdArrowRed" markerWidth="10" markerHeight="10" refX="7.5" refY="5" orient="auto">
                <path d="M0,0 L10,5 L0,10 Z" fill="#FF4444" />
              </marker>
              <marker id="fdArrowGreen" markerWidth="10" markerHeight="10" refX="7.5" refY="5" orient="auto">
                <path d="M0,0 L10,5 L0,10 Z" fill="#00E396" />
              </marker>
              <radialGradient id="fdGapGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="rgba(251,48,121,0.30)" />
                <stop offset="100%" stop-color="rgba(251,48,121,0)" />
              </radialGradient>
            </defs>

            <!-- Visitor -->
            <rect x="14" y="112" width="182" height="76" rx="14" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.14)" />
            <text x="105" y="156" text-anchor="middle" fill="#EEF0FF" font-family="DM Sans, sans-serif" font-size="18" font-weight="700">Visitor asks</text>
            <line x1="196" y1="150" x2="272" y2="150" stroke="rgba(238,240,255,0.28)" stroke-width="2" />

            <!-- The gap -->
            <ellipse class="fd-flow-glow" cx="338" cy="150" rx="70" ry="70" fill="url(#fdGapGlow)" />
            <polygon points="338,102 414,150 338,198 262,150" fill="rgba(251,48,121,0.10)" stroke="#FB3079" stroke-width="2" />
            <text x="338" y="156" text-anchor="middle" fill="#EEF0FF" font-family="DM Sans, sans-serif" font-size="15" font-weight="600">The gap</text>

            <!-- No answer -->
            <path d="M414,150 C505,150 525,72 612,72" fill="none" stroke="rgba(255,68,68,0.5)" stroke-width="2" marker-end="url(#fdArrowRed)" />
            <text x="505" y="58" text-anchor="middle" fill="rgba(238,240,255,0.62)" font-family="DM Sans, sans-serif" font-size="13" font-weight="500">No answer</text>
            <rect x="628" y="40" width="178" height="66" rx="14" fill="rgba(255,68,68,0.08)" stroke="#FF4444" />
            <text x="717" y="79" text-anchor="middle" fill="#EEF0FF" font-family="DM Sans, sans-serif" font-size="16" font-weight="700">They leave</text>

            <!-- Front Desk answers -->
            <path class="fd-flow-path" d="M414,150 C505,150 525,228 612,228" fill="none" stroke="#00E396" stroke-width="2.5" marker-end="url(#fdArrowGreen)" />
            <text x="505" y="245" text-anchor="middle" fill="#00E5FF" font-family="DM Sans, sans-serif" font-size="13" font-weight="600">Front Desk answers</text>
            <rect x="628" y="196" width="178" height="66" rx="14" fill="rgba(0,227,150,0.12)" stroke="#00E396" />
            <text x="717" y="235" text-anchor="middle" fill="#EEF0FF" font-family="DM Sans, sans-serif" font-size="16" font-weight="700">They buy</text>

            <circle class="fd-spark fd-spark--1" r="4" fill="#7DF9FF" />
            <circle class="fd-spark fd-spark--2" r="3" fill="#00E5FF" />
          </svg>

          <!-- Small screens get a legible stack instead of a shrunken diagram. -->
          <div class="fd-flow-mobile" aria-hidden="true">
            <div class="fd-flow-step">Visitor asks</div>
            <span class="fd-flow-arrow">↓</span>
            <div class="fd-flow-step fd-flow-step--gap">The gap</div>
            <div class="fd-flow-ends">
              <div class="fd-flow-end fd-flow-end--bad">
                <span class="fd-flow-end-label">No answer</span>
                They leave
              </div>
              <div class="fd-flow-end fd-flow-end--good">
                <span class="fd-flow-end-label">Front Desk answers</span>
                They buy
              </div>
            </div>
          </div>
        </div>

        <div class="fd-cta-row fade-up fade-up-delay-4">
          <a
            href={DEPOSIT_HREF}
            class="fd-btn fd-btn--primary"
            data-cta="deposit"
            data-track-event="front_desk_cta_clicked"
            data-evt-cta="deposit"
            data-evt-position="hero"
          >Pay {DEPOSIT_AMOUNT} and skip the line</a>
          <a
            href={TOUR_HREF}
            target="_blank"
            rel="noopener"
            class="fd-btn-text"
            data-track-event="front_desk_cta_clicked"
            data-evt-cta="experience_tour"
            data-evt-position="hero"
          >Or book a free 20 minute Experience Tour first</a>
          <span class="fd-cta-note">Your deposit locks your onboarding call this week.</span>
        </div>
      </div>
    </section>

    <!-- ══ THIS IS FOR YOU ═══════════════════════════════════ -->
    <section class="fd-section fd-people-section">
      <div class="fd-wrap">
        <span class="fd-kicker reveal-up">This is for you</span>
        <h2 class="fd-center-heading reveal-up reveal-delay-1">
          For the teacher. The maker. The corner shop.
        </h2>
        <p class="fd-center-sub reveal-up reveal-delay-2">
          No enterprise budget needed. This was built at your size.
        </p>

        <div class="fd-people">
          {people.map((p, i) => (
            <div class="fd-person reveal-card" style={`--reveal-i:${i}`}>
              <span class="fd-person-icon" aria-hidden="true">{p.icon}</span>
              <span class="fd-person-title">{p.title}</span>
              <span class="fd-person-note">{p.note}</span>
            </div>
          ))}
        </div>
        <p class="fd-people-more reveal-up">
          Tutors, trainers, cleaners, detailers, studios, clinics, salons. If people book
          you, buy from you, or sign up with you, you need a front desk.
        </p>
      </div>
    </section>

    <!-- ══ ONE SIMPLE QUESTION ═══════════════════════════════ -->
    <section class="fd-section">
      <div class="fd-wrap">
        <span class="fd-kicker reveal-up">One simple question</span>
        <h2 class="fd-q-heading reveal-up reveal-delay-1">
          When someone wants to book you or buy from you, can they do it
          <span class="fd-green">on their own time</span>, or do they have to
          <span class="fd-orange">wait to talk to you?</span>
        </h2>

        <div class="fd-compare">
          <div class="fd-compare-card fd-compare--bad reveal-card">
            <span class="fd-compare-title fd-compare-title--bad">Without a Front Desk</span>
            <ul class="fd-list">
              {withoutItems.map((item) => (
                <li><span class="fd-x" aria-hidden="true">✕</span>{item}</li>
              ))}
            </ul>
          </div>
          <div class="fd-compare-card fd-compare--good reveal-card" style="--reveal-i:1">
            <span class="fd-compare-title fd-compare-title--good">With the Front Desk</span>
            <ul class="fd-list">
              {withItems.map((item) => (
                <li><span class="fd-check" aria-hidden="true">✓</span>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ WHAT YOU GET ══════════════════════════════════════ -->
    <section class="fd-section" id="what-you-get">
      <div class="fd-wrap">
        <span class="fd-kicker reveal-up">What you get</span>
        <h2 class="fd-center-heading reveal-up reveal-delay-1">
          A front desk and a receptionist, in one.
        </h2>
      </div>
    </section>

    <!-- ── Part one: the Front Desk ── -->
    <section id="front-desk" class="fd-part">
      <div class="fd-wrap feature-grid">
        <div class="feature-text fd-part-copy reveal-up">
          <span class="fd-part-eyebrow fd-part-eyebrow--cyan">
            <span class="fd-part-icon" aria-hidden="true">🛎</span> Part One
          </span>
          <h3 class="fd-part-title">The Front Desk</h3>
          <p class="fd-part-body">
            Your storefront that is always open. People pick a time, choose a service or a
            pack, and pay, all on their own, in under a minute. No phone tag. No invoices.
            The money lands before the first appointment.
          </p>
          <ul class="fd-points">
            {frontDeskPoints.map((p) => (
              <li><span class="fd-point-icon" aria-hidden="true">{p.icon}</span>{p.text}</li>
            ))}
          </ul>
        </div>

        <div class="feature-mock">
          <div class="fd-mock fd-mock--book reveal-card">
            <div class="fd-book-head">
              <span class="fd-book-kicker">Front Desk for Teachers</span>
              <span class="fd-book-title">Book a lesson</span>
            </div>
            <div class="fd-book-body">
              <span class="fd-book-label">Pick a time</span>
              <div class="fd-slots">
                <div class="fd-slot"><span class="fd-slot-day">Sat</span><span class="fd-slot-time">8:00</span></div>
                <div class="fd-slot is-active"><span class="fd-slot-day">Sun</span><span class="fd-slot-time">6:30</span></div>
                <div class="fd-slot"><span class="fd-slot-day">Sun</span><span class="fd-slot-time">9:00</span></div>
              </div>
              <div class="fd-pack">
                <div class="fd-pack-info">
                  <span class="fd-pack-name">10-Lesson Pack</span>
                  <span class="fd-pack-note">Best value, save 20%</span>
                </div>
                <span class="fd-pack-price">$450</span>
              </div>
              <span class="fd-fake-btn">Pay and book my spot</span>
              <span class="fd-book-foot">Secure checkout. Your spot is held while you pay.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Part two: the Receptionist ── -->
    <section id="receptionist" class="fd-part">
      <div class="fd-wrap feature-grid reverse">
        <div class="feature-mock">
          <div class="fd-mock fd-mock--chat reveal-card">
            <div class="fd-chat-head">
              <span class="fd-chat-avatar" aria-hidden="true">R</span>
              <span class="fd-chat-id">
                <span class="fd-chat-name">The Receptionist</span>
                <span class="fd-chat-status"><span class="fd-dot-green" aria-hidden="true"></span>Always answers</span>
              </span>
            </div>
            <div class="fd-chat-body">
              <div class="fd-msg fd-msg--in">Hi, thanks for reaching out to Front Desk For Teachers! 👋🏾 How can I help you today?</div>
              <div class="fd-quick">
                <span class="fd-chip">Book a lesson</span>
                <span class="fd-chip">Buy a pack</span>
                <span class="fd-chip">Ask a question</span>
                <span class="fd-chip">Talk to a human</span>
              </div>
              <div class="fd-msg fd-msg--out">Do you have weekend lessons for beginners?</div>
              <div class="fd-msg fd-msg--in">Yes. Saturdays and Sundays at 8am are perfect for first timers. Want me to book you in? I can take payment right here. 🙌🏾</div>
              <span class="fd-fake-btn">Yes, book me in →</span>
            </div>
          </div>
        </div>

        <div class="feature-text fd-part-copy reveal-up">
          <span class="fd-part-eyebrow fd-part-eyebrow--purple">
            <span class="fd-part-icon" aria-hidden="true">💁</span> Part Two
          </span>
          <h3 class="fd-part-title">The Receptionist</h3>
          <p class="fd-part-body">
            The friendly front door of your business. Like a five star hotel, it greets
            every call, text, and message: thanks for stopping by, how can I help? Then it
            points each person to the right place, answers the easy questions, and books
            them in, so nothing slips through.
          </p>
          <ul class="fd-points">
            {receptionistPoints.map((p) => (
              <li><span class="fd-point-icon" aria-hidden="true">{p.icon}</span>{p.text}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Part three: the Insights ── -->
    <section id="insights" class="fd-part">
      <div class="fd-wrap feature-grid">
        <div class="feature-text fd-part-copy reveal-up">
          <span class="fd-part-eyebrow fd-part-eyebrow--green">
            <span class="fd-part-icon" aria-hidden="true">📈</span> Part Three
          </span>
          <h3 class="fd-part-title">The Insights</h3>
          <p class="fd-part-body">
            It reads what is happening so you always know your next move. When people
            book. What they buy. What they skip. That kind of reporting used to cost
            enterprise money. Here it comes with the desk.
          </p>
        </div>

        <div class="feature-mock">
          <div class="fd-mock fd-mock--stats reveal-card">
            <div class="fd-stats-head">
              <span class="fd-stats-title">This week</span>
              <span class="fd-stats-tag">Example view</span>
            </div>
            <div class="fd-stats-grid">
              {insightStats.map((s) => (
                <div class="fd-stat">
                  <span class="fd-stat-value">{s.value}</span>
                  <span class="fd-stat-label">{s.label}</span>
                </div>
              ))}
            </div>
            <p class="fd-stats-read">
              Sunday evenings are your busiest hour. Two of the three packs sold started
              in a message after 9pm.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ THE TRUTH ═════════════════════════════════════════ -->
    <section class="fd-section">
      <div class="fd-wrap fd-narrow">
        <span class="fd-kicker fd-kicker--left reveal-up">The truth</span>
        <h2 class="fd-left-heading reveal-up reveal-delay-1">
          Nobody stays up at night thinking about you.
        </h2>
        <div class="fd-identity reveal-card">
          <p class="fd-identity-lead">
            The big companies get the systems, the support, the tools that make it all
            run. The small business owner is left to figure it out alone.
          </p>
          <p>
            We build for you. All day. Systems that carry the weight, so you make more,
            stress less, and stop being the only reason things move.
          </p>
        </div>
      </div>
    </section>

    <!-- ══ THE UNFAIR PART ═══════════════════════════════════ -->
    <section class="fd-section">
      <div class="fd-wrap fd-narrow">
        <span class="fd-kicker fd-kicker--left reveal-up">The unfair part</span>
        <h2 class="fd-left-heading reveal-up reveal-delay-1">
          This kind of help only existed for the big guys.
        </h2>
        <p class="fd-lead reveal-up reveal-delay-2">
          Enterprise means the giant companies. Whole teams to answer the phone. Whole
          tools to read the numbers. That was never something you could buy. We built it
          for you instead.
        </p>

        <div class="fd-stack">
          <div class="fd-card reveal-card">
            <h3 class="fd-card-title fd-card-title--green">It reads your numbers</h3>
            <p>
              When people book, what they buy, what they skip. That insight used to cost
              enterprise money. Now it is yours.
            </p>
          </div>
          <div class="fd-card reveal-card" style="--reveal-i:1">
            <h3 class="fd-card-title fd-card-title--cyan">We do not have to be here</h3>
            <p>We could build for the giants. We choose you, on purpose, every day.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ WHAT IT GIVES BACK ════════════════════════════════ -->
    <section class="fd-section">
      <div class="fd-wrap">
        <span class="fd-kicker reveal-up">What it gives back to you</span>
        <h2 class="fd-gives-heading reveal-up reveal-delay-1">
          <span class="fd-green">More money.</span>
          <span class="fd-cyan">Less stress.</span>
          <span class="fd-orange">More time for you.</span>
        </h2>

        <div class="fd-gives-grid">
          {gives.map((g, i) => (
            <div class={`fd-give fd-give--${g.key} reveal-card`} style={`--reveal-i:${i}`}>
              <span class="fd-give-title">{g.title}</span>
              <p class="fd-give-body">{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ FROM DEPOSIT TO LIVE ══════════════════════════════ -->
    <section class="fd-section">
      <div class="fd-wrap fd-narrow">
        <span class="fd-kicker fd-kicker--left reveal-up">From deposit to live</span>
        <h2 class="fd-left-heading reveal-up reveal-delay-1">Four steps. That is it.</h2>

        <div class="fd-steps">
          {steps.map((s, i) => (
            <div class="fd-step reveal-card" style={`--reveal-i:${i}`}>
              <span class="fd-step-idx">{i + 1}</span>
              <div class="fd-step-copy">
                <h3 class="fd-step-title">
                  <span class="fd-step-icon" aria-hidden="true">{s.icon}</span>{s.title}
                </h3>
                <p class="fd-step-body">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ WE PICK WHO WE WORK WITH ══════════════════════════ -->
    <section class="fd-section">
      <div class="fd-wrap fd-narrow">
        <span class="fd-kicker fd-kicker--left reveal-up">One more thing</span>
        <h2 class="fd-left-heading reveal-up reveal-delay-1">We pick who we work with.</h2>
        <div class="fd-identity fd-identity--pick reveal-card">
          <p class="fd-identity-lead">
            This is about more than the money. Nowhere gives you this much for this little.
          </p>
          <p>
            It is about you. Your standard. Your care. How you treat the people you serve.
            We work with the ones who take it seriously. If that is you, let us talk.
          </p>
        </div>
      </div>
    </section>

    <!-- ══ FINAL CTA ═════════════════════════════════════════ -->
    <section class="fd-section fd-cta-section" data-section-view="front_desk_final_cta">
      <div class="fd-wrap">
        <div class="fd-final reveal-card">
          <span class="fd-kicker">Get in front of the line</span>
          <h2 class="fd-final-title">Start today.</h2>
          <p class="fd-final-sub">
            Pay the {DEPOSIT_AMOUNT} deposit and lock your onboarding call this week.
            The bonus of {offer.bonus} is on while the season lasts.
          </p>
          <a
            href={DEPOSIT_HREF}
            class="fd-btn fd-btn--primary"
            data-cta="deposit"
            data-track-event="front_desk_cta_clicked"
            data-evt-cta="deposit"
            data-evt-position="final"
          >Pay {DEPOSIT_AMOUNT} and skip the line</a>
          <p class="fd-final-fine">
            Prefer to look first?
            <a
              href={TOUR_HREF}
              target="_blank"
              rel="noopener"
              data-track-event="front_desk_cta_clicked"
              data-evt-cta="experience_tour"
              data-evt-position="final"
            >Book a free 20 minute Experience Tour.</a>
          </p>
          <span class="fd-final-foot">Built by CWK. Experience</span>
        </div>
      </div>
    </section>

  </div>
</Base>

<style>
  /* Stage colors used as local names so the palette stays exact. */
  .fd {
    --green: #00E396;   /* stage 6 */
    --orange: #FF7A30;  /* stage 2 */
    --red: #FF4444;     /* stage 1 */
    display: block;
  }

  .fd-wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .fd-narrow { max-width: 820px; }

  .fd-cyan   { color: var(--cyan); }
  .fd-green  { color: var(--green); }
  .fd-orange { color: var(--orange); }

  .fd-section { padding-top: 84px; }

  /* Eyebrow. Pink is the brand default, per docs/DESIGN.md. */
  .fd-kicker {
    display: block;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--pink);
    margin-bottom: 16px;
  }
  .fd-kicker--left { text-align: left; }

  .fd-center-heading {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
    font-size: clamp(26px, 3.6vw, 40px);
    font-weight: 800;
    line-height: 1.18;
  }
  .fd-center-sub {
    text-align: center;
    max-width: 560px;
    margin: 14px auto 0;
    font-size: 15px;
    color: var(--muted);
  }
  .fd-left-heading {
    font-size: clamp(24px, 3.4vw, 36px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .fd-lead {
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 640px;
  }

  /* ── HERO ─────────────────────────────────────────────── */
  .fd-hero {
    position: relative;
    overflow: hidden;
    padding-top: 104px;
    padding-bottom: 24px;
    text-align: center;
  }
  .fd-hero-glow {
    position: absolute;
    top: -180px;
    left: 50%;
    width: min(920px, 96vw);
    height: 620px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at 50% 40%, rgba(0, 229, 255, 0.10) 0%, rgba(123, 97, 255, 0.06) 45%, transparent 72%);
    filter: blur(10px);
    pointer-events: none;
    z-index: 0;
  }
  .fd-hero-inner { position: relative; z-index: 1; }

  /* Offer bar */
  .fd-offer {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    padding: 9px 20px;
    margin-bottom: 26px;
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid var(--gb);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .fd-offer-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .fd-offer-item b { color: var(--green); font-weight: 700; }
  .fd-offer-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--gb2); }

  .fd-dot-green {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(0, 227, 150, 0.7);
  }

  .fd-open-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    background: rgba(0, 227, 150, 0.08);
    border: 1px solid rgba(0, 227, 150, 0.30);
    color: var(--green);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    margin-bottom: 24px;
  }

  .fd-hero-title {
    font-size: clamp(36px, 6.2vw, 62px);
    font-weight: 800;
    line-height: 1.08;
    margin: 0 auto 22px;
    max-width: 900px;
  }
  .fd-hero-grad {
    display: block;
    background: linear-gradient(135deg, #00E5FF, #7B61FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .fd-hero-sub {
    max-width: 600px;
    margin: 0 auto;
    font-size: clamp(15px, 1.7vw, 18px);
    line-height: 1.6;
    color: var(--muted);
  }
  .fd-hero-sub b { color: var(--text); font-weight: 600; }

  /* ── The gap diagram ──────────────────────────────────── */
  .fd-flow { position: relative; margin: 24px auto 0; max-width: 780px; }
  .fd-flow-svg { display: block; width: 100%; height: auto; }

  .fd-flow-glow { animation: fdGapPulse 2.8s ease-in-out infinite; }
  @keyframes fdGapPulse {
    0%, 100% { opacity: 0.5; }
    50%      { opacity: 1; }
  }

  .fd-flow-path {
    stroke-dasharray: 5 9;
    animation: fdDash 1.1s linear infinite;
  }
  @keyframes fdDash { to { stroke-dashoffset: -14; } }

  /* Travelling spark. CSS motion path rather than SMIL so reduced-motion
     and unsupporting browsers can both opt out cleanly. */
  .fd-spark {
    offset-path: path("M105,150 L272,150 L338,150 C505,150 525,228 612,228");
    offset-rotate: 0deg;
    animation: fdSpark 2.6s linear infinite;
    filter: drop-shadow(0 0 5px rgba(0, 229, 255, 0.85));
  }
  .fd-spark--2 { animation-delay: 1.3s; }
  @keyframes fdSpark {
    from { offset-distance: 0%; opacity: 0; }
    12%  { opacity: 1; }
    88%  { opacity: 1; }
    to   { offset-distance: 100%; opacity: 0; }
  }
  @supports not (offset-path: path("M0,0 L1,1")) {
    .fd-spark { display: none; }
  }

  .fd-flow-mobile { display: none; }

  /* ── Hero CTAs ────────────────────────────────────────── */
  .fd-cta-row {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
