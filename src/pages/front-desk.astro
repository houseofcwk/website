---
import Base from '../layouts/Base.astro';

const pageTitle = 'The Front Desk | CWK. Experience';
const pageDescription =
  'The front desk and receptionist your business never had. Customers book your services and buy your products on their own time, 24/7, and every new lead gets greeted and pointed the right way, day or night.';

// Primary CTA target (flagged for Kris, swap to a waitlist/booking URL if preferred).
const CTA_HREF = '/contact';

const withoutItems = [
  "Calls and texts pile up while you're working.",
  'People give up when no one answers fast.',
  'You chase payments after the work is done.',
  "Your nights and days off aren't really yours.",
];
const withItems = [
  'Customers book and buy themselves, 24/7.',
  'Every lead gets a warm answer in seconds.',
  "You're paid up front, before you start.",
  'Your time goes back to the work you love.',
];

const frontDeskPoints = [
  { icon: '📅', text: 'Pick a time and book in seconds' },
  { icon: '💳', text: 'Pay up front, or buy a multi-pack' },
  { icon: '🔁', text: 'Rebook with one tap, come back again' },
];
const receptionistPoints = [
  { icon: '👋🏾', text: 'Greets every new lead in seconds' },
  { icon: '🧭', text: 'Routes them to the right service or answer' },
  { icon: '🙌🏾', text: 'Hands you only the people who need you' },
];

const useCases = [
  { icon: '🏄🏾', title: 'Classes & workshops', body: "Students book lessons and buy class packs while you're busy teaching." },
  { icon: '🚐', title: 'Mobile & delivery', body: 'Customers pick a time and address, pay up front, and you just show up.' },
  { icon: '💇🏾', title: 'Local services', body: 'Your day fills itself, every spot booked and paid before they walk in.' },
  { icon: '💻', title: 'Virtual sessions', body: 'Clients grab an online slot and pay, with 0 back-and-forth emails.' },
  { icon: '📦', title: 'Products & goods', body: 'Regulars reorder and pay in two taps, any time of day or night.' },
];

const gives = [
  { key: 'money', title: 'More money', body: "You're paid the moment someone books, and the easy upsell to a pack happens on its own." },
  { key: 'stress', title: 'Less stress', body: 'No missed calls, no late-night messages. The front desk and receptionist never clock out.' },
  { key: 'time', title: 'Time back', body: 'The busywork runs itself, so your hours go to the work you actually want to do.' },
];
---

<Base title={pageTitle} description={pageDescription}>
  <div class="fd">

    <!-- ══ HERO ══════════════════════════════════════════════ -->
    <section class="fd-hero">
      <div class="fd-hero-glow" aria-hidden="true"></div>
      <div class="fd-wrap fd-hero-inner">
        <span class="fd-open-badge fade-up">
          <span class="fd-dot-green"></span>
          OPEN 24 / 7
        </span>
        <h1 class="fd-hero-title fade-up fade-up-delay-1">
          The Front Desk<br />
          <span class="fd-cyan">for your business.</span>
        </h1>
        <p class="fd-hero-sub fade-up fade-up-delay-2">
          The front desk and receptionist your business never had. Customers book your
          services and buy your products on their own time, and every new lead gets
          greeted and pointed the right way, day or night.
        </p>
        <div class="fd-hero-pills fade-up fade-up-delay-3">
          <a href="#front-desk" class="fd-pill fd-pill--cyan">
            <span class="fd-pill-title">The Front Desk</span>
            <span class="fd-pill-sub">Books &amp; sells for you</span>
          </a>
          <a href="#receptionist" class="fd-pill fd-pill--purple">
            <span class="fd-pill-title">The Receptionist</span>
            <span class="fd-pill-sub">Greets &amp; routes every lead</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ══ ONE SIMPLE QUESTION ═══════════════════════════════ -->
    <section class="fd-section fd-question">
      <div class="fd-wrap">
        <span class="fd-kicker reveal-up">One Simple Question</span>
        <h2 class="fd-q-heading reveal-up reveal-delay-1">
          When someone wants to book your service or buy from you, can they do it
          <span class="fd-green">on their own time</span>, or do they have to
          <span class="fd-orange">wait to talk to you?</span>
        </h2>

        <div class="fd-compare">
          <div class="fd-compare-card fd-compare--bad reveal-card">
            <span class="fd-compare-title fd-compare-title--bad">Without a Front Desk</span>
            <ul class="fd-list">
              {withoutItems.map((item) => (
                <li><span class="fd-x" aria-hidden="true">✕</span>{item}</li>
              ))}
            </ul>
          </div>
          <div class="fd-compare-card fd-compare--good reveal-card" style="--reveal-i:1">
            <span class="fd-compare-title fd-compare-title--good">With the Front Desk</span>
            <ul class="fd-list">
              {withItems.map((item) => (
                <li><span class="fd-check" aria-hidden="true">✓</span>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ PART ONE - THE FRONT DESK ═════════════════════════ -->
    <section id="front-desk" class="fd-section fd-part">
      <div class="fd-wrap feature-grid">
        <div class="feature-text fd-part-copy reveal-up">
          <span class="fd-part-eyebrow fd-part-eyebrow--cyan">
            <span class="fd-part-icon">🛎</span> Part One
          </span>
          <h2 class="fd-part-title">The Front Desk</h2>
          <p class="fd-part-body">
            Your storefront that's always open. Customers pick a time, choose a class or
            a pack, and pay, all on their own, in under a minute. No phone tag. No
            invoices. The money lands before the first appointment.
          </p>
          <ul class="fd-points">
            {frontDeskPoints.map((p) => (
              <li><span class="fd-point-icon">{p.icon}</span>{p.text}</li>
            ))}
          </ul>
        </div>

        <div class="feature-mock">
          <!-- Booking mock card -->
          <div class="fd-mock fd-mock--book reveal-card">
            <div class="fd-book-head">
              <span class="fd-book-kicker">Front Desk for Teachers</span>
              <span class="fd-book-title">Book a lesson</span>
            </div>
            <div class="fd-book-body">
              <span class="fd-book-label">Pick a time</span>
              <div class="fd-slots">
                <div class="fd-slot"><span class="fd-slot-day">Sat</span><span class="fd-slot-time">8:00</span></div>
                <div class="fd-slot is-active"><span class="fd-slot-day">Sun</span><span class="fd-slot-time">6:30</span></div>
                <div class="fd-slot"><span class="fd-slot-day">Sun</span><span class="fd-slot-time">9:00</span></div>
              </div>
              <div class="fd-pack">
                <div class="fd-pack-info">
                  <span class="fd-pack-name">10-Lesson Pack</span>
                  <span class="fd-pack-note">Best value · save 20%</span>
                </div>
                <span class="fd-pack-price">$450</span>
              </div>
              <button class="fd-book-btn" type="button" tabindex="-1" aria-hidden="true">Pay &amp; book my spot</button>
              <span class="fd-book-foot">Secure checkout · your spot is held while you pay</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ PART TWO - THE RECEPTIONIST ═══════════════════════ -->
    <section id="receptionist" class="fd-section fd-part">
      <div class="fd-wrap feature-grid reverse">
        <div class="feature-mock">
          <!-- Receptionist chat mock card -->
          <div class="fd-mock fd-mock--chat reveal-card">
            <div class="fd-chat-head">
              <span class="fd-chat-avatar">R</span>
              <span class="fd-chat-id">
                <span class="fd-chat-name">The Receptionist</span>
                <span class="fd-chat-status"><span class="fd-dot-green"></span>Always answers</span>
              </span>
            </div>
            <div class="fd-chat-body">
              <div class="fd-msg fd-msg--in">Hi, thanks for reaching out to Front Desk For Teachers! 👋🏾 How can I help you today?</div>
              <div class="fd-quick">
                <span class="fd-chip">Book a lesson</span>
                <span class="fd-chip">Buy a pack</span>
                <span class="fd-chip">Ask a question</span>
                <span class="fd-chip">Talk to a human</span>
              </div>
              <div class="fd-msg fd-msg--out">Do you have weekend lessons for beginners?</div>
              <div class="fd-msg fd-msg--in">Yes! Saturdays and Sundays at 8am are perfect for first-timers. Want me to book you in? I can take payment right here. 🙌🏾</div>
              <button class="fd-chat-btn" type="button" tabindex="-1" aria-hidden="true">Yes, book me in →</button>
            </div>
          </div>
        </div>

        <div class="feature-text fd-part-copy reveal-up">
          <span class="fd-part-eyebrow fd-part-eyebrow--purple">
            <span class="fd-part-icon">💁</span> Part Two
          </span>
          <h2 class="fd-part-title">The Receptionist</h2>
          <p class="fd-part-body">
            The friendly front door of your business. Like a five-star hotel, it greets
            every call, text, and message: "Thanks for stopping by, how can I help?" Then
            it points each person to the right place, answers the easy questions, and
            books them in, so nothing slips through.
          </p>
          <ul class="fd-points">
            {receptionistPoints.map((p) => (
              <li><span class="fd-point-icon">{p.icon}</span>{p.text}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ══ FITS THE WAY YOU WORK ═════════════════════════════ -->
    <section class="fd-section fd-fits">
      <div class="fd-wrap">
        <span class="fd-kicker reveal-up">Fits the way you work</span>
        <h2 class="fd-center-heading reveal-up reveal-delay-1">
          If people book you, buy from you, or sign up with you, you need a front desk.
        </h2>

        <div class="fd-cases">
          {useCases.map((c, i) => (
            <div class="fd-case reveal-card" style={`--reveal-i:${i}`}>
              <span class="fd-case-icon">{c.icon}</span>
              <span class="fd-case-title">{c.title}</span>
              <p class="fd-case-body">{c.body}</p>
            </div>
          ))}
          <div class="fd-case fd-case--more reveal-card" style="--reveal-i:5">
            <span class="fd-case-title">And many more</span>
            <p class="fd-case-body">Tutors, trainers, cleaners, detailers, studios, clinics, salons…</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ WHAT IT GIVES BACK ════════════════════════════════ -->
    <section class="fd-section fd-gives">
      <div class="fd-wrap">
        <span class="fd-kicker reveal-up">What it gives back to you</span>
        <h2 class="fd-gives-heading reveal-up reveal-delay-1">
          <span class="fd-green">More money.</span>
          <span class="fd-cyan">Less stress.</span>
          <span class="fd-orange">More time for you.</span>
        </h2>

        <div class="fd-gives-grid">
          {gives.map((g, i) => (
            <div class={`fd-give fd-give--${g.key} reveal-card`} style={`--reveal-i:${i}`}>
              <span class="fd-give-title">{g.title}</span>
              <p class="fd-give-body">{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ FINAL CTA ═════════════════════════════════════════ -->
    <section class="fd-section fd-cta-section">
      <div class="fd-wrap">
        <div class="fd-cta reveal-card">
          <h2 class="fd-cta-title">Every business deserves a front desk.</h2>
          <p class="fd-cta-sub">Let's set up yours.</p>
          <a href={CTA_HREF} class="fd-cta-btn">Get The Front Desk →</a>
          <span class="fd-cta-foot">· Built by CWK. Experience</span>
        </div>
      </div>
    </section>

  </div>
</Base>

<style>
  .fd {
    --green: #00E396;
    --orange: #FF8A3D;
    --red: #FF5C6C;
    display: block;
  }

  .fd-wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .fd-cyan   { color: var(--cyan); }
  .fd-green  { color: var(--green); }
  .fd-orange { color: var(--orange); }

  /* Section rhythm */
  .fd-section { padding-block: 80px; }

  /* Shared kicker (centered uppercase gradient label) */
  .fd-kicker {
    display: block;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    background: linear-gradient(90deg, #00E5FF, #7B61FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 18px;
  }

  .fd-center-heading {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
    font-size: clamp(26px, 3.6vw, 40px);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  /* ── HERO ─────────────────────────────────────────────── */
  .fd-hero {
    position: relative;
    overflow: hidden;
    padding-top: 132px;
    padding-bottom: 84px;
    text-align: center;
  }
  .fd-hero-glow {
    position: absolute;
    top: -180px;
    left: 50%;
    width: min(920px, 96vw);
    height: 620px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at 50% 40%, rgba(0, 229, 255, 0.10) 0%, rgba(123, 97, 255, 0.06) 45%, transparent 72%);
    filter: blur(10px);
    pointer-events: none;
    z-index: 0;
  }
  .fd-hero-inner { position: relative; z-index: 1; }

  .fd-open-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 100px;
    background: rgba(0, 227, 150, 0.08);
    border: 1px solid rgba(0, 227, 150, 0.30);
    color: var(--green);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 26px;
  }
  .fd-dot-green {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(0, 227, 150, 0.7);
  }

  .fd-hero-title {
    font-size: clamp(40px, 7vw, 76px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 0 0 22px;
  }

  .fd-hero-sub {
    max-width: 620px;
    margin: 0 auto 32px;
    font-size: clamp(15px, 1.7vw, 18px);
    line-height: 1.6;
    color: var(--muted);
  }

  .fd-hero-pills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .fd-pill {
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: flex-start;
    text-align: left;
    padding: 14px 22px;
    border-radius: 14px;
    background: var(--glass);
    border: 1px solid var(--gb);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .fd-pill:hover { transform: translateY(-2px); opacity: 1; }
  .fd-pill--cyan:hover   { border-color: rgba(0, 229, 255, 0.45); box-shadow: 0 10px 30px rgba(0, 229, 255, 0.12); }
  .fd-pill--purple:hover { border-color: rgba(123, 97, 255, 0.45); box-shadow: 0 10px 30px rgba(123, 97, 255, 0.12); }
  .fd-pill-title { font-size: 15px; font-weight: 700; }
  .fd-pill--cyan   .fd-pill-title { color: var(--cyan); }
  .fd-pill--purple .fd-pill-title { color: var(--purple); }
  .fd-pill-sub { font-size: 12px; color: var(--dim); }

  /* ── ONE SIMPLE QUESTION ──────────────────────────────── */
  .fd-q-heading {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 44px;
    font-size: clamp(26px, 3.8vw, 42px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .fd-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }
  .fd-compare-card {
    padding: 26px 28px;
    border-radius: 16px;
    background: var(--glass);
    border: 1px solid var(--gb);
  }
  .fd-compare--bad  { background: rgba(255, 92, 108, 0.05); border-color: rgba(255, 92, 108, 0.22); }
  .fd-compare--good { background: rgba(0, 227, 150, 0.05);  border-color: rgba(0, 227, 150, 0.22); }

  .fd-compare-title {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .fd-compare-title--bad  { color: var(--red); }
  .fd-compare-title--good { color: var(--green); }

  .fd-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .fd-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(238, 240, 255, 0.82);
  }
  .fd-x, .fd-check {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.5;
  }
  .fd-x { color: var(--red); }
  .fd-check { color: var(--green); }

  /* ── PARTS (feature grid) ─────────────────────────────── */
  .fd-part { scroll-margin-top: 90px; }
  .fd-part .feature-grid { max-width: 1080px; margin: 0 auto; }

  .fd-part-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .fd-part-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 15px 6px 12px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .fd-part-eyebrow--cyan   { background: rgba(0, 229, 255, 0.08);  border: 1px solid rgba(0, 229, 255, 0.24);  color: var(--cyan); }
  .fd-part-eyebrow--purple { background: rgba(123, 97, 255, 0.08); border: 1px solid rgba(123, 97, 255, 0.24); color: var(--purple); }
  .fd-part-icon { font-size: 13px; }

  .fd-part-title {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .fd-part-body { font-size: 16px; line-height: 1.7; color: var(--muted); margin: 0; }

  .fd-points { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }
  .fd-points li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15.5px;
    font-weight: 500;
    color: var(--text);
  }
  .fd-point-icon {
    flex-shrink: 0;
    width: 38px; height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--glass);
    border: 1px solid var(--gb);
    font-size: 17px;
  }

  /* ── Booking mock ─────────────────────────────────────── */
  .fd-mock {
    border-radius: 18px;
    overflow: hidden;
    background: var(--bg3);
    border: 1px solid var(--gb);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
    max-width: 420px;
    width: 100%;
    margin: 0 auto;
  }
  .fd-book-head {
    padding: 20px 22px;
    background: linear-gradient(135deg, #00E5FF 0%, #7B61FF 100%);
    color: #07090F;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fd-book-kicker { font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.75; }
  .fd-book-title { font-size: 20px; font-weight: 800; letter-spacing: -0.01em; }

  .fd-book-body { padding: 22px; display: flex; flex-direction: column; gap: 16px; }
  .fd-book-label { font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .fd-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .fd-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 12px 6px;
    border-radius: 12px;
    background: var(--glass);
    border: 1px solid var(--gb);
  }
  .fd-slot.is-active {
    background: rgba(0, 229, 255, 0.12);
    border-color: rgba(0, 229, 255, 0.55);
    box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.25) inset;
  }
  .fd-slot-day { font-size: 11px; font-weight: 600; color: var(--dim); text-transform: uppercase; letter-spacing: 0.08em; }
  .fd-slot.is-active .fd-slot-day { color: var(--cyan); }
  .fd-slot-time { font-size: 17px; font-weight: 700; color: var(--text); }

  .fd-pack {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--glass);
    border: 1px solid var(--gb);
  }
  .fd-pack-info { display: flex; flex-direction: column; gap: 2px; }
  .fd-pack-name { font-size: 14px; font-weight: 700; color: var(--text); }
  .fd-pack-note { font-size: 11px; color: var(--green); }
  .fd-pack-price { font-size: 22px; font-weight: 800; color: var(--text); letter-spacing: -0.02em; }

  .fd-book-btn, .fd-chat-btn {
    width: 100%;
    padding: 13px 18px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(180deg, #00E396 0%, #00C27E 100%);
    color: #04120C;
    font-family: var(--font-primary);
    font-size: 14.5px;
    font-weight: 700;
    cursor: default;
    text-align: center;
  }
  .fd-book-foot { font-size: 11px; color: var(--dim); text-align: center; }

  /* ── Receptionist chat mock ───────────────────────────── */
  .fd-mock--chat { max-width: 400px; }
  .fd-chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--gb);
    background: var(--bg2);
  }
  .fd-chat-avatar {
    width: 38px; height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #7B61FF, #FB3079);
    color: #fff;
    font-size: 15px;
    font-weight: 800;
  }
  .fd-chat-id { display: flex; flex-direction: column; gap: 2px; }
  .fd-chat-name { font-size: 14px; font-weight: 700; color: var(--text); }
