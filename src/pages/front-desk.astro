  .fd-step-idx {
    flex-shrink: 0;
    min-width: 30px;
    font-size: 20px;
    font-weight: 800;
    color: var(--dim);
    line-height: 1.4;
  }
  .fd-step-copy { display: flex; flex-direction: column; gap: 4px; }
  .fd-step-title {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
  }
  .fd-step-icon { font-size: 15px; }
  .fd-step-body { font-size: 14.5px; line-height: 1.6; color: var(--muted); margin: 0; }

  /* ── Final CTA ────────────────────────────────────────── */
  .fd-cta-section { padding-bottom: 20px; }
  .fd-final {
    max-width: 760px;
    margin: 0 auto;
    padding: 52px 32px;
    border-radius: 18px;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(0, 229, 255, 0.08), transparent 60%),
      linear-gradient(180deg, var(--bg2), var(--bg3));
    border: 1px solid var(--gb);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
