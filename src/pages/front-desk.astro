  .fd-btn--primary { background: var(--cyan); color: var(--bg); }
  .fd-btn--primary:hover { filter: brightness(1.1); color: var(--bg); opacity: 1; }
  .fd-btn--primary:active { transform: scale(0.98); }

  .fd-btn-text {
    font-size: 14px;
    color: var(--muted);
    border-bottom: 1px solid var(--gb2);
    padding-bottom: 2px;
  }
  .fd-btn-text:hover { color: var(--text); opacity: 1; }
  .fd-cta-note { font-size: 13px; color: var(--dim); }

  /* ── This is for you ──────────────────────────────────── */
  .fd-people {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gap-tile);
    margin-top: 32px;
  }
  .fd-person {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    padding: 24px 14px;
    background: var(--glass);
    border: 1px solid var(--gb);
    border-radius: var(--radius-card);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .fd-person:hover { border-color: var(--gb2); transform: translateY(-3px); }
  .fd-person-icon { font-size: 28px; line-height: 1; }
  .fd-person-title { font-size: 14px; font-weight: 700; color: var(--text); margin-top: 8px; }
  .fd-person-note { font-size: 12px; color: var(--muted); }
  .fd-people-more {
    max-width: 640px;
    margin: 22px auto 0;
    text-align: center;
    font-size: 14px;
    color: var(--dim);
  }

  /* ── One simple question ──────────────────────────────── */
  .fd-q-heading {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 32px;
    font-size: clamp(25px, 3.6vw, 40px);
    font-weight: 800;
    line-height: 1.22;
  }

  .fd-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-tile);
    max-width: 900px;
    margin: 0 auto;
  }
  .fd-compare-card {
    padding: var(--pad-md);
    border-radius: var(--radius-card);
    background: var(--glass);
    border: 1px solid var(--gb);
  }
  .fd-compare--bad  { background: rgba(255, 68, 68, 0.05); border-top: 2px solid var(--red); }
  .fd-compare--good { background: rgba(0, 227, 150, 0.05); border-top: 2px solid var(--green); }

  .fd-compare-title {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.20em;
    text-transform: uppercase;
