  .fd-pack-note { font-size: 11px; color: var(--green); }
  .fd-pack-price { font-size: 22px; font-weight: 800; color: var(--text); }

  /* Decorative button inside the mocks. A span, not a <button>, so screen
     readers and keyboards never land on a control that does nothing. */
  .fd-fake-btn {
    display: block;
    width: 100%;
    padding: 13px 18px;
    border-radius: 12px;
    background: linear-gradient(180deg, #00E396 0%, #00C27E 100%);
