    border: 1px solid rgba(0, 229, 255, 0.22);
    color: var(--cyan);
    font-size: 12px;
    font-weight: 600;
  }

  /* Insights mock */
  .fd-mock--stats { padding: 22px; }
  .fd-stats-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .fd-stats-title { font-size: 15px; font-weight: 700; color: var(--text); }
  .fd-stats-tag {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    border: 1px solid var(--gb);
    border-radius: var(--radius-pill);
    padding: 4px 10px;
  }
  .fd-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-tile); }
  .fd-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 12px;
    border-radius: 12px;
    background: var(--glass);
    border: 1px solid var(--gb);
  }
  .fd-stat-value { font-size: 26px; font-weight: 800; color: var(--cyan); line-height: 1; }
  .fd-stat-label { font-size: 11px; color: var(--muted); line-height: 1.35; }
  .fd-stats-read {
    margin-top: 16px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    padding-left: 12px;
    border-left: 2px solid rgba(0, 227, 150, 0.5);
  }

  /* ── Identity blocks ──────────────────────────────────── */
  .fd-identity {
    margin-top: 20px;
    padding: 32px 30px;
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, rgba(123, 97, 255, 0.07), rgba(251, 48, 121, 0.04));
    border: 1px solid var(--gb);
    border-top: 2px solid var(--pink);
  }
  .fd-identity--pick {
    background: linear-gradient(180deg, rgba(0, 229, 255, 0.06), rgba(123, 97, 255, 0.04));
    border-top-color: var(--cyan);
  }
  .fd-identity p { font-size: 16px; line-height: 1.65; color: var(--muted); }
  .fd-identity p + p { margin-top: 14px; }
  .fd-identity-lead { font-size: 18px !important; color: var(--text) !important; line-height: 1.55 !important; }

  /* ── Stacked cards ────────────────────────────────────── */
  .fd-stack { display: flex; flex-direction: column; gap: var(--gap-tile); margin-top: 20px; }
  .fd-card {
    padding: var(--pad-md);
    border-radius: var(--radius-card);
    background: var(--glass);
    border: 1px solid var(--gb);
    transition: border-color 0.2s ease, transform 0.2s ease;
