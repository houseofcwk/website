  .fd-part-eyebrow--purple { background: rgba(123, 97, 255, 0.08); border: 1px solid rgba(123, 97, 255, 0.24); color: var(--purple); }
  .fd-part-eyebrow--green  { background: rgba(0, 227, 150, 0.08);  border: 1px solid rgba(0, 227, 150, 0.26);  color: var(--green); }
  .fd-part-icon { font-size: 13px; }

  .fd-part-title {
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 800;
