    font-size: 14px;
    font-weight: 700;
    text-align: center;
  }
  .fd-book-foot { font-size: 11px; color: var(--dim); text-align: center; }

  .fd-mock--chat { max-width: 400px; }
  .fd-chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--gb);
    background: var(--bg2);
