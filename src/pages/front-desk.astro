  .fd-x { color: var(--red); }
  .fd-check { color: var(--green); }

  /* ── Parts ────────────────────────────────────────────── */
  .fd-part { padding-top: 56px; scroll-margin-top: 88px; }
  .fd-part .feature-grid { max-width: 1080px; margin: 0 auto; }

  .fd-part-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .fd-part-eyebrow {
