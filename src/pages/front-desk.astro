  .fd-card-title { font-size: 17px; font-weight: 700; margin-bottom: 6px; }
  .fd-card-title--green { color: var(--green); }
  .fd-card-title--cyan  { color: var(--cyan); }

  /* ── What it gives back ───────────────────────────────── */
  .fd-gives-heading {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 32px;
    font-size: clamp(27px, 4vw, 44px);
    font-weight: 800;
    line-height: 1.15;
  }
  .fd-gives-heading span { display: inline; }

  .fd-gives-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-tile);
    max-width: 1000px;
    margin: 0 auto;
  }
  .fd-give {
    padding: 26px 26px 28px;
    border-radius: var(--radius-card);
    background: var(--glass);
    border: 1px solid var(--gb);
