---
import Base from '../layouts/Base.astro';
import FeaturedVideoSection from '../components/FeaturedVideoSection.astro';
import {
  CATEGORIES,
  ARCHETYPES,
  SPEEDS,
  MINES,
} from '../data/lifestyleCalculator';

const pageTitle = 'Lifestyle Map | CWK. Experience';
const pageDescription =
  'Turn your lifestyle aspirations into a concrete income target and a plan that fits the pace you can actually keep. Six squares. Real numbers. No fluff.';
---

<Base title={pageTitle} description={pageDescription}>
  <!-- Access veil: covers the tool until the gate resolves (paid/admin -> reveal,
       else redirect to the landing). Prevents a flash of the calculator. -->
  <div id="lc-gate-veil" class="lc-gate-veil">Loading…</div>
  <section class="lc-page">
    <div class="lc-wrap">

      <!-- Board path indicator -->
      <div class="lc-board-wrap">
        <div class="lc-board" id="lcBoard"></div>
      </div>

      <!-- ── SECTION 01: YOUR EDGE ─────────────────────────── -->
      <div id="lc-step-0" class="lc-step is-active">
        <span class="lc-eyebrow"><span class="lc-eyebrow-dot"></span>SECTION 01 / YOUR CATEGORY</span>
        <h1 class="lc-h1">What does your<br><span class="lc-grad">lifestyle really cost?</span></h1>
        <p class="lc-sub">Pick the type of service business you run.</p>

        <div class="lc-cat-grid">
          {CATEGORIES.map((cat) => (
            <button type="button" class={`lc-cat-tile lc-${cat.key}`} data-cat={cat.key}>
              <span class="lc-cat-icon" aria-hidden="true">
                {cat.icon === 'creative' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z"/></svg>
                )}
                {cat.icon === 'business' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                )}
                {cat.icon === 'other' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                )}
              </span>
              <span class="lc-cat-label">{cat.label}</span>
              <span class="lc-cat-desc">{cat.desc}</span>
              <span class="lc-cat-check" aria-hidden="true">✓</span>
            </button>
          ))}
        </div>

        <div class="lc-nav-row" style="margin-top:28px;">
          <button type="button" class="lc-btn-next" data-next="0">Continue →</button>
        </div>
      </div>

      <!-- ── SECTION 02: YOUR STAGE ────────────────────────── -->
      <div id="lc-step-1" class="lc-step">
        <span class="lc-eyebrow"><span class="lc-eyebrow-dot"></span>SECTION 02 / YOUR STAGE</span>
        <h1 class="lc-h1">Where are you<br><span class="lc-grad">right now?</span></h1>
        <p class="lc-sub">Not where you want to be. Where you actually are today. Read each one and pick the card that sounds like your internal monologue this week.</p>

        <div class="lc-arch-list">
          {ARCHETYPES.map((a) => (
            <button type="button" class="lc-arch-card" data-arch={a.key}>
              <span class="lc-arch-check" aria-hidden="true">✓</span>
              <div class="lc-arch-header">
                <div class="lc-arch-name-wrap">
                  <span class="lc-arch-tag">{a.tag}</span>
                  <div class="lc-arch-name">{a.name}</div>
                </div>
                <div class="lc-arch-dots" aria-hidden="true">
                  {[1, 2, 3, 4, 5].map((d) => (
                    <span class={`lc-arch-dot ${d === a.stage ? 'is-active' : ''}`}></span>
                  ))}
                </div>
              </div>
              <div class="lc-arch-tagline">{a.cost}</div>
              <div class="lc-arch-feeling">{a.feeling}</div>
            </button>
          ))}
        </div>

        <div class="lc-nav-row">
          <button type="button" class="lc-btn-back" data-back="1">←</button>
          <button type="button" class="lc-btn-next" data-next="1">Continue →</button>
        </div>
      </div>

      <!-- ── SECTION 03: THE PRIZE ─────────────────────────── -->
      <div id="lc-step-2" class="lc-step">
        <span class="lc-eyebrow"><span class="lc-eyebrow-dot"></span>SECTION 03 / THE PRIZE</span>
        <h1 class="lc-h1">Where do you<br><span class="lc-grad">want to be?</span></h1>
        <p class="lc-sub">Let's calculate what it would take to bring this to life.</p>
        <p class="lc-helper">Use your best estimate. The map is only as honest as the numbers you give it.</p>
        <p class="lc-section-tag">The real numbers to get to where you want to be.</p>

        <div class="lc-field-grid">
          <div class="lc-field-group">
            <label class="lc-field-label" for="lc-monthly-goal">How much do you want to make a month?</label>
            <div class="lc-field-prefix">
              <span class="lc-field-prefix-mark">$</span>
              <input type="number" id="lc-monthly-goal" placeholder="10,000" min="1" inputmode="numeric" />
            </div>
          </div>
          <div class="lc-field-group">
            <label class="lc-field-label" for="lc-offer-price">How much is your service?</label>
            <div class="lc-field-prefix">
              <span class="lc-field-prefix-mark">$</span>
              <input type="number" id="lc-offer-price" placeholder="2,500" min="1" inputmode="numeric" />
            </div>
          </div>
        </div>

        <div class="lc-nav-row">
          <button type="button" class="lc-btn-back" data-back="2">←</button>
          <button type="button" class="lc-btn-next" data-next="2">Continue →</button>
        </div>
      </div>

      <!-- ── SECTION 04: PROGRESS SPEED ────────────────────── -->
      <div id="lc-step-3" class="lc-step">
        <span class="lc-eyebrow"><span class="lc-eyebrow-dot"></span>SECTION 04 / PROGRESS SPEED</span>
        <h1 class="lc-h1">How fast are<br><span class="lc-grad">you willing to move?</span></h1>
        <p class="lc-sub">Pick the one you will actually show up at. There are no wrong answers.</p>

        <div class="lc-speed-grid">
          {SPEEDS.map((s) => (
            <button type="button" class={`lc-speed-card lc-speed-${s.key}`} data-speed={s.key}>
              <span class="lc-speed-symbol" aria-hidden="true">
                {s.key === 'turtle' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16a5 5 0 0 0 5-5 5 5 0 0 0-10 0 5 5 0 0 0 5 5z"/><path d="M5 11a7 7 0 0 1 14 0"/><path d="M3 16h2"/><path d="M19 16h2"/><path d="M5 19l1-2"/><path d="M19 19l-1-2"/><path d="M9 19l-1 2"/><path d="M15 19l1 2"/></svg>
                )}
                {s.key === 'car' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>
                )}
                {s.key === 'rocket' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
                )}
              </span>
              <span class="lc-speed-label">{s.label}</span>
              <span class="lc-speed-time">{s.time}</span>
              <span class="lc-speed-desc">{s.desc}</span>
              <span class="lc-speed-check" aria-hidden="true">✓</span>
            </button>
          ))}
        </div>

        <div class="lc-nav-row">
          <button type="button" class="lc-btn-back" data-back="3">←</button>
          <button type="button" class="lc-btn-next" data-next="3">Continue →</button>
        </div>
      </div>

      <!-- ── SECTION 05: THE TWO BRIDGES ───────────────────── -->
      <div id="lc-step-4" class="lc-step">
        <span class="lc-eyebrow"><span class="lc-eyebrow-dot"></span>SECTION 05 / THE TWO BRIDGES</span>
        <h1 class="lc-h1">Here's what<br><span class="lc-grad">the numbers say.</span></h1>
        <p class="lc-sub">There are 2 bridges people need to cross in order to make money. Bridge 1: from strangers to interested. Bridge 2: from interested to buyer. These numbers show the path to your destination.</p>
        <p class="lc-helper">Defaults below assume 1% and 20%, honest baselines for someone with no existing audience. Adjust if you have real data.</p>

        <div class="lc-funnel-top" id="lcFunnelTop"></div>
        <div class="lc-funnel-arrows" id="lcFunnelArrows"></div>
        <div class="lc-funnel-bottom" id="lcFunnelBottom"></div>

        <hr class="lc-divider" />

        <div class="lc-adjust-block">
          <div class="lc-adjust-title">
            <span class="lc-adjust-optional">Optional</span>
            Adjust for your real conversion rates
          </div>
          <div class="lc-adjust-grid">
            <div class="lc-adjust-field">
              <label for="lc-s2l-rate">Stranger → Lead (%)</label>
              <input type="number" id="lc-s2l-rate" placeholder="1" min="0.1" max="100" step="0.1" />
            </div>
            <div class="lc-adjust-field">
              <label for="lc-l2s-rate">Lead → Sale (%)</label>
              <input type="number" id="lc-l2s-rate" placeholder="20" min="0.1" max="100" step="0.1" />
            </div>
          </div>
        </div>

        <div class="lc-nav-row">
          <button type="button" class="lc-btn-back" data-back="4">←</button>
          <button type="button" class="lc-btn-next" data-next="4">Continue →</button>
        </div>
      </div>

      <!-- ── SECTION 06: MIND MINES ────────────────────────── -->
      <div id="lc-step-5" class="lc-step">
        <span class="lc-eyebrow"><span class="lc-eyebrow-dot"></span>SECTION 06 / MIND MINES</span>
        <h1 class="lc-h1">What's<br><span class="lc-grad">in your way?</span></h1>
        <p class="lc-sub">These are not character flaws. They are the actual cost of playing. Select every one that is true right now. The more honest you are here, the more useful your map becomes.</p>

        <div class="lc-mine-list">
          {MINES.map((m) => (
            <div class="lc-mine-item" data-mine={m.key}>
              <div class="lc-mine-stat-bar">{m.stat}</div>
              <div class="lc-mine-body">
                <div class="lc-mine-check" aria-hidden="true">✓</div>
                <div class="lc-mine-content">
                  <div class="lc-mine-label">{m.label}</div>
                  <div class="lc-mine-desc">{m.desc}</div>
                  <div class="lc-mine-fix">{m.fix}</div>
                </div>
              </div>
            </div>
          ))}
          <div class="lc-mine-item" data-mine="none">
            <div class="lc-mine-body">
              <div class="lc-mine-check" aria-hidden="true">✓</div>
              <div class="lc-mine-content">
                <div class="lc-mine-label">None of these. I am clear.</div>
                <div class="lc-mine-desc">You have done the inner work, or none of these are active blocks right now.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="lc-nav-row">
          <button type="button" class="lc-btn-back" data-back="5">←</button>
          <button type="button" class="lc-btn-next" data-next="5">Build my lifestyle map →</button>
        </div>
      </div>

      <!-- ── RESULTS ──────────────────────────────────────── -->
      <div id="lc-step-6" class="lc-step">
        <span class="lc-eyebrow"><span class="lc-eyebrow-dot"></span>YOUR LIFESTYLE MAP</span>
        <h1 class="lc-h1"><span class="lc-grad">Your complete<br>picture.</span></h1>
        <p class="lc-sub">Where you are. Where you want to be. What it actually takes to get there. Everything in one place so you can make a real decision.</p>

        <!-- Hero stats card -->
        <div class="lc-player-header lc-reveal">
          <div class="lc-player-badges" id="lcPlayerBadges"></div>
          <div class="lc-player-headline" id="lcPlayerHeadline"></div>
          <div class="lc-player-stats" id="lcPlayerStats"></div>
        </div>

        <!-- Where you are now / Where you want to be, side-by-side -->
        <div class="lc-now-goal lc-reveal">
          <div class="lc-now-goal-col lc-now-goal-now">
            <span class="lc-section-label">WHERE YOU ARE RIGHT NOW</span>
            <div id="lcResArchetype"></div>
          </div>
          <div class="lc-now-goal-col lc-now-goal-goal">
            <span class="lc-section-label">WHERE YOU WANT TO BE</span>
            <div id="lcResDestination"></div>
          </div>
        </div>

        <!-- Phase roadmap -->
        <div class="lc-reveal">
          <span class="lc-section-label">YOUR PHASE ROADMAP</span>
          <div class="lc-phase-grid" id="lcResPhases"></div>
        </div>

        <!-- Tools -->
        <div class="lc-reveal">
          <span class="lc-section-label">RECOMMENDED TOOLS FOR YOUR JOURNEY</span>
          <div id="lcResTools"></div>
        </div>

        <!-- Skills -->
        <div class="lc-reveal">
          <span class="lc-section-label">WHAT DO YOU NEED TO LEARN</span>
          <div id="lcResSkills"></div>
        </div>

        <!-- People -->
        <div class="lc-reveal">
          <span class="lc-section-label">PEOPLE YOU NEED</span>
          <div id="lcResPeople"></div>
        </div>

        <!-- Stress -->
        <div class="lc-reveal">
          <span class="lc-section-label">THE STRESS REALITY</span>
          <div id="lcResStress"></div>
        </div>

        <!-- Mind mines results -->
        <div class="lc-reveal">
          <div id="lcResMines"></div>
          <div id="lcResWarning"></div>
        </div>

        <!-- Lifestyle Protocol (EDIT step 7): placed between Stress Reality and
             the CTA. Copy + intensity tiers (by monthly revenue goal) pending —
             hidden until that content is provided, then always shown. -->
        <div class="lc-reveal" id="lcResProtocolWrap" hidden>
          <span class="lc-section-label">LIFESTYLE PROTOCOL</span>
          <div id="lcResProtocol"></div>
        </div>

        <!-- Save the map (replaces "Email me my map") -->
        <div class="lc-savemap lc-reveal">
          <button type="button" class="lc-savemap-btn" id="lcSaveMapBtn">Save this map</button>
          <p class="lc-savemap-note">Opens a print-ready version you can save or bookmark — no email required.</p>
        </div>

        <!-- CTA -->
        <div class="lc-cta-section lc-reveal">
          <div class="lc-cta-intro">
            <span class="lc-cta-eyebrow">YOUR NEXT MOVE</span>
            <h2 class="lc-cta-title">You have the map.<br>What you do with it is the game.</h2>
            <p class="lc-cta-sub">Two options. One moves faster than the other. Neither is wrong. One is just more intentional.</p>
          </div>
          <div class="lc-cta-paths">
            <div class="lc-cta-path lc-cta-path-a">
              <span class="lc-path-label lc-path-a-label">PATH A</span>
              <div class="lc-cta-path-title">Tour CWK. HQ</div>
              <p class="lc-cta-path-desc">See how the game is actually played. 20 minutes. No pitch. Just the full picture of how CWK. builds with founders.</p>
              <a class="lc-btn-path-a" id="lcPathABtn" href="https://calendly.com/cwkexperience/experience-tour" target="_blank" rel="noopener">Take free tour →</a>
            </div>
            <div class="lc-cta-path lc-cta-path-b">
              <span class="lc-path-label lc-path-b-label">PATH B</span>
              <div class="lc-cta-path-title">Find your people.</div>
              <p class="lc-cta-path-desc">The World Builders Community is free. It is where founders at your stage are building in public, sharing what is working, and moving together.</p>
              <a class="lc-btn-path-b" id="lcPathBBtn" href="https://www.skool.com/world-builders-the-build-lab-6158/about" target="_blank" rel="noopener">Join the community →</a>
            </div>
          </div>
        </div>

        <div class="lc-footer-note">
          Built by <a href="https://cwkexperience.com" target="_blank" rel="noopener">CWK. Experience</a>
          &nbsp;·&nbsp; Build. Learn. Earn. Play.
        </div>
      </div>

    </div>
  </section>

  <div data-lc-featured-video>
    <FeaturedVideoSection />
  </div>

  <!-- Print-only report. Hidden on screen; the ONLY thing shown when printing
       (see @media print). Populated from the same data by renderPrintReport()
       so the PDF is a clean linear document, not a screenshot of the dark UI. -->
  <div id="lc-print" class="lc-print" aria-hidden="true"></div>
</Base>

<script>
  import {
    ARCHETYPES,
    MINES,
    SPEEDS,
    RECOMMENDED_TOOLS,
    RECOMMENDED_TOOLS_TOTAL,
    SKILLS,
    PEOPLE,
    PHASES,
    SPEED_MONTHS,
    SPEED_EMOJI,
    SPEED_TIME_LABELS,
    type CategoryKey,
    type SpeedKey,
    type ArchetypeKey,
    type MineKey,
    type CalculatorState,
  } from '../data/lifestyleCalculator';
  import { track, conversion } from '../lib/analytics';

  function bucketCurrency(n: number): string {
    if (!n || n < 5000) return '<5k';
    if (n < 10000) return '5-10k';
    if (n < 25000) return '10-25k';
    if (n < 50000) return '25-50k';
    return '50k+';
  }
  let stepEnteredAt = Date.now();

  // ── State ───────────────────────────────────────────────
  const STORAGE_KEY = 'cwk:lifestyle-calculator:v1';
  const SQUARE_LABELS = ['01', '02', '03', '04', '05', '06', '★'];

  const initialState: CalculatorState = {
    ideaCategory: '',
    ideaType: '',
    archetype: '',
    monthlyGoal: 0,
    offerPrice: 0,
    hoursWeek: 0,
    timeMonths: 0,
    speed: '',
    s2l: 1,
    l2s: 20,
    mines: [],
  };

  let state: CalculatorState = { ...initialState };
  let currentStep = 0;

  function loadState(): void {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const parsed = JSON.parse(raw) as { state?: CalculatorState; step?: number };
      if (parsed.state) state = { ...initialState, ...parsed.state };
      if (typeof parsed.step === 'number' && parsed.step >= 0 && parsed.step <= 6) {
        currentStep = parsed.step;
      }
    } catch {
      // bad JSON, start fresh
    }
  }

  function saveState(): void {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({ state, step: currentStep })
      );
    } catch {
      // localStorage disabled or full
    }
  }

  function clearState(): void {
    try { localStorage.removeItem(STORAGE_KEY); } catch {}
  }

  // ── Board ───────────────────────────────────────────────
  function renderBoard(active: number): void {
    const board = document.getElementById('lcBoard');
    if (!board) return;
    let html = '';
    for (let i = 0; i < SQUARE_LABELS.length; i++) {
      if (i > 0) html += '<div class="lc-board-conn"></div>';
      const isGoal = i === SQUARE_LABELS.length - 1;
      const cls = [
        'lc-board-sq',
        isGoal ? 'is-goal' : '',
        i < active ? 'is-done' : '',
        i === active ? 'is-active' : '',
      ].filter(Boolean).join(' ');
      html += `<div class="${cls}">${SQUARE_LABELS[i]}</div>`;
    }
    board.innerHTML = html;
  }

  // ── Navigation ──────────────────────────────────────────
  function triggerResultReveals(): void {
    const targets = document.querySelectorAll<HTMLElement>('#lc-step-6 .lc-reveal');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced || typeof IntersectionObserver === 'undefined') {
      targets.forEach((el) => el.classList.add('is-revealed'));
      return;
    }
    targets.forEach((el) => el.classList.remove('is-revealed'));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('is-revealed');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.04 });
    targets.forEach((el) => io.observe(el));
  }

  function showStep(n: number): void {
    document.querySelectorAll<HTMLElement>('.lc-step').forEach((el) => {
      el.classList.remove('is-active');
    });
    const target = document.getElementById(`lc-step-${n}`);
    if (target) target.classList.add('is-active');
    currentStep = n;
    renderBoard(n);
    saveState();

    const fv = document.querySelector<HTMLElement>('[data-lc-featured-video]');
    if (fv) fv.hidden = n !== 0;

    if (n === 4) renderFunnel();
    if (n === 6) {
      buildResults();
      triggerResultReveals();
      // The user has completed the flow. Drop the persisted state so a
      // refresh restarts from step 0 rather than reopening the result
      // page with stale inputs. State is held in memory until the user
      // clicks "Run a new idea" (resetAll) or navigates away.
      clearState();
    }

    const wrap = document.querySelector<HTMLElement>('.lc-page');
    if (wrap) {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      requestAnimationFrame(() => {
        wrap.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
      });
    }
  }

  function flashEl(id: string): void {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.add('lc-flash');
    setTimeout(() => el.classList.remove('lc-flash'), 1400);
  }

  // ── Step 0: category (sub-step removed) ─────────────────
  function selectCat(key: CategoryKey, btn: HTMLElement): void {
    document.querySelectorAll('.lc-cat-tile').forEach((el) => el.classList.remove('is-selected'));
    btn.classList.add('is-selected');
    state.ideaCategory = key;
    state.ideaType = '';
    saveState();
    track('lc_category_selected', { category: key });
  }

  // Months for the selected speed (drives all timeline math now that the
  // "months to hit your goal" input is gone). Falls back to Car (18).
  function speedMonths(): number {
    return state.speed ? SPEED_MONTHS[state.speed] : SPEED_MONTHS.car;
  }

  // ── Step 1: archetype ──────────────────────────────────
  function wireArchetypes(): void {
    document.querySelectorAll<HTMLButtonElement>('.lc-arch-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.lc-arch-card').forEach((el) => el.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        state.archetype = (btn.dataset.arch as ArchetypeKey) ?? '';
        saveState();
        const archMeta = ARCHETYPES.find((a) => a.key === state.archetype);
        track('lc_archetype_selected', {
          archetype_key: state.archetype,
          archetype_stage: archMeta?.stage ?? 0,
        });
      });
    });
  }

  // ── Step 3: speed ──────────────────────────────────────
  function wireSpeeds(): void {
    document.querySelectorAll<HTMLButtonElement>('.lc-speed-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.lc-speed-card').forEach((el) => el.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        state.speed = (btn.dataset.speed as SpeedKey) ?? '';
        // EDIT (step 5): the timeline horizon now comes from the speed pick.
        if (state.speed) state.timeMonths = SPEED_MONTHS[state.speed];
        saveState();
        track('lc_speed_selected', { speed: state.speed });
      });
    });
  }

  // ── Step 5: mines ──────────────────────────────────────
  function toggleMine(item: HTMLElement, key: string): void {
    if (key === 'none') {
      state.mines = [];
      document.querySelectorAll('.lc-mine-item').forEach((el) => el.classList.remove('is-selected'));
      item.classList.add('is-selected');
      saveState();
      return;
    }
    // Deselect "none"
    const noneItem = document.querySelector('.lc-mine-item[data-mine="none"]');
    if (noneItem) noneItem.classList.remove('is-selected');

    const mineKey = key as MineKey;
    const idx = state.mines.indexOf(mineKey);
    if (idx >= 0) {
      state.mines.splice(idx, 1);
      item.classList.remove('is-selected');
    } else {
      state.mines.push(mineKey);
      item.classList.add('is-selected');
    }
    saveState();
  }

  function wireMines(): void {
    document.querySelectorAll<HTMLElement>('.lc-mine-item').forEach((item) => {
      item.addEventListener('click', () => {
        toggleMine(item, item.dataset.mine ?? '');
      });
    });
  }

  // ── Math ───────────────────────────────────────────────
  function calcNumbers(): {
    totalSales: number; totalLeads: number; totalStrangers: number; weeks: number;
    salesPw: number; leadsPw: number; strangersPw: number;
  } {
    const g = state.monthlyGoal, p = state.offerPrice, m = state.timeMonths;
    const s2l = state.s2l, l2s = state.l2s;
    const weeks = Math.max(1, m * 4.33);
    const totalSales = Math.ceil((g * m) / Math.max(1, p));
    const totalLeads = Math.ceil(totalSales / (l2s / 100));
    const totalStrangers = Math.ceil(totalLeads / (s2l / 100));
    return {
      totalSales, totalLeads, totalStrangers, weeks,
      salesPw: Math.ceil(totalSales / weeks),
      leadsPw: Math.ceil(totalLeads / weeks),
      strangersPw: Math.ceil(totalStrangers / weeks),
    };
  }

  // Honest per-week cadence. Below 1/week we'd round up and overstate the pace,
  // so express it as "1 every N weeks" (e.g. 36 sales over ~78 weeks → 1 / 2 wks).
  function cadence(total: number, weeks: number, plural: string, singular: string): { num: string; lbl: string; prose: string } {
    const perWeek = total / weeks;
    if (perWeek >= 1) {
      const n = Math.ceil(perWeek);
      return { num: fmt(n), lbl: plural + ' / week', prose: fmt(n) + ' per week' };
    }
    const every = Math.max(2, Math.round(weeks / Math.max(1, total)));
    return { num: '1', lbl: singular + ' every ' + every + ' weeks', prose: '1 every ' + every + ' weeks' };
  }

  function fmt(n: number): string {
    return new Intl.NumberFormat('en-US').format(Math.round(n));
  }

  function fmtK(n: number): string {
    if (n >= 1000) return (n / 1000).toFixed(n % 1000 === 0 ? 0 : 1) + 'k';
    return fmt(n);
  }

  function renderFunnel(): void {
    const n = calcNumbers();
    const top = document.getElementById('lcFunnelTop');
    const arrows = document.getElementById('lcFunnelArrows');
    const bottom = document.getElementById('lcFunnelBottom');
    if (!top || !arrows || !bottom) return;

    const strangers = cadence(n.totalStrangers, n.weeks, 'New people', 'New person');
    const leads = cadence(n.totalLeads, n.weeks, 'Leads', 'Lead');
    const sales = cadence(n.totalSales, n.weeks, 'Sales', 'Sale');
    top.innerHTML =
      fCard(strangers.num, strangers.lbl) +
      fCard(leads.num, leads.lbl) +
      fCard(sales.num, sales.lbl);
    arrows.innerHTML = '<span>↓</span><span>↓</span><span>↓</span>';
    bottom.innerHTML = `
      <div class="lc-funnel-card lc-funnel-total">
        <div class="lc-funnel-total-num">${fmt(n.totalSales)}</div>
        <div class="lc-funnel-total-meta">
          <div class="lc-funnel-lbl">Total sales over ${state.timeMonths} months</div>
          <p>To reach $${fmtK(state.monthlyGoal)}/mo at $${fmtK(state.offerPrice)} per offer.</p>
        </div>
      </div>`;
  }

  function fCard(num: string, lbl: string): string {
    return `<div class="lc-funnel-card"><div class="lc-funnel-num">${num}</div><div class="lc-funnel-lbl">${lbl}</div></div>`;
  }

  // ── Validation per-step ────────────────────────────────
  function validateStep(step: number): boolean {
    if (step === 0) {
      if (!state.ideaCategory) {
        flashEl('lc-step-0');
        return false;
      }
      return true;
    }
    if (step === 1) {
      if (!state.archetype) {
        flashEl('lc-step-1');
        return false;
      }
      return true;
    }
    if (step === 2) {
      const g = parseFloat((document.getElementById('lc-monthly-goal') as HTMLInputElement).value);
      const p = parseFloat((document.getElementById('lc-offer-price') as HTMLInputElement).value);
      if (!g || !p) {
        flashEl('lc-step-2');
        return false;
      }
      state.monthlyGoal = g;
      state.offerPrice = p;
      return true;
    }
    if (step === 3) {
      if (!state.speed) {
        flashEl('lc-step-3');
        return false;
      }
      return true;
    }
    if (step === 4) {
      const s2lEl = document.getElementById('lc-s2l-rate') as HTMLInputElement;
      const l2sEl = document.getElementById('lc-l2s-rate') as HTMLInputElement;
      const s2l = parseFloat(s2lEl.value) || 1;
      const l2s = parseFloat(l2sEl.value) || 20;
      state.s2l = s2l;
      state.l2s = l2s;
      return true;
    }
    return true;
  }

  // ── Results ────────────────────────────────────────────
  function getArch(key: ArchetypeKey | ''): typeof ARCHETYPES[number] | null {
    return ARCHETYPES.find((a) => a.key === key) ?? null;
  }

  function statCell(val: string, lbl: string): string {
    return `<div class="lc-stat-cell"><div class="lc-stat-val">${val}</div><div class="lc-stat-lbl">${lbl}</div></div>`;
  }

  function escapeHtml(s: string): string {
    return s.replace(/[<>&"']/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }

  function buildResults(): void {
    const n = calcNumbers();
    const arch = getArch(state.archetype);
    const cat = state.ideaCategory;
    const spd = state.speed || 'car';

    const catLabels: Record<string, string> = {
      creative: 'Creative Services',
      business: 'Business Services',
      other: 'Other',
    };
    const catLabel = cat ? (catLabels[cat] ?? '') : '';

    // Identity
    const badges = document.getElementById('lcPlayerBadges');
    if (badges && cat) {
      badges.innerHTML =
        `<span class="lc-player-badge lc-badge-${cat}">${escapeHtml(catLabel)}</span>` +
        (arch ? `<span class="lc-player-badge lc-badge-stage">${arch.tag} / ${arch.name}</span>` : '');
    }

    const headline = document.getElementById('lcPlayerHeadline');
    if (headline) {
      headline.innerHTML = `A <span>${arch ? arch.name : ''}</span> running ${escapeHtml(catLabel || 'your service')}, targeting $${fmtK(state.monthlyGoal)}/month.`;
    }

    const stats = document.getElementById('lcPlayerStats');
    if (stats) {
      // EDIT (step 7): third stat is SPEED (emoji + speed range), not a static Runway.
      const speedDef = SPEEDS.find((s) => s.key === spd);
      const speedVal = `${SPEED_EMOJI[spd] ?? ''} ${speedDef ? speedDef.time : ''}`.trim();
      stats.innerHTML =
        statCell('$' + fmtK(state.monthlyGoal) + '/mo', 'Target') +
        statCell('$' + fmtK(state.offerPrice), 'Service') +
        statCell(speedVal, 'Speed');
    }

    // Archetype snapshot
    const archEl = document.getElementById('lcResArchetype');
    if (archEl && arch) {
      archEl.innerHTML = `
        <div class="lc-arch-snapshot">
          <span class="lc-arch-snap-tag">${arch.tag} / ${arch.name.toUpperCase()}</span>
          <div class="lc-arch-snap-name">${arch.name}</div>
          <div class="lc-arch-snap-feel">${arch.feeling}</div>
        </div>`;
    }

    // Destination
    const dest = document.getElementById('lcResDestination');
    if (dest) {
      dest.innerHTML = `
        <div class="lc-res-card">
          <span class="lc-res-badge">YOUR TARGET</span>
          <div class="lc-res-val">$${fmt(state.monthlyGoal)} / month</div>
          <div class="lc-res-desc">That is $${fmt(state.monthlyGoal * 12)}/year. At $${fmt(state.offerPrice)} per offer you need ${fmt(n.totalSales)} sales over ${state.timeMonths} months, ${cadence(n.totalSales, n.weeks, 'sales', 'sale').prose}. To close those you need to reach ${fmt(n.strangersPw)} brand-new people every single week.</div>
        </div>`;
    }

    // Tools — EDIT (step 7): generic categories + price ranges (no brand names).
    const toolRows = RECOMMENDED_TOOLS.map(
      (t) => `<div class="lc-tool-row"><span class="lc-tool-row-label">${escapeHtml(t.label)}</span><span class="lc-tool-row-price">${escapeHtml(t.price)}</span></div>`,
    ).join('');
    const toolsEl = document.getElementById('lcResTools');
    if (toolsEl) {
      toolsEl.innerHTML = `
        <div class="lc-breakdown-card">
          <span class="lc-breakdown-title">Recommended tools for your journey</span>
          <div class="lc-tool-rows">${toolRows}</div>
          <div class="lc-tool-cost">${escapeHtml(RECOMMENDED_TOOLS_TOTAL)}</div>
        </div>`;
    }

    // Skills — EDIT (step 7): heading renamed to "What do you need to learn".
    const skillList = cat ? SKILLS[cat] : [];
    const skillsEl = document.getElementById('lcResSkills');
    if (skillsEl) {
      skillsEl.innerHTML = `
        <div class="lc-res-card">
          <span class="lc-res-badge">What do you need to learn</span>
          <div class="lc-skill-list">
            ${skillList.map((s, i) => `<div class="lc-skill-item"><div class="lc-skill-num">${i + 1}</div><div class="lc-skill-text">${escapeHtml(s)}</div></div>`).join('')}
          </div>
        </div>`;
    }

    // People
    const ppl = PEOPLE[spd];
    const peopleEl = document.getElementById('lcResPeople');
    if (peopleEl) {
      peopleEl.innerHTML = `
        <div class="lc-res-card">
          <span class="lc-res-badge">PEOPLE YOU NEED, AT YOUR SPEED</span>
          <div class="lc-people-list">
            ${ppl.list.map((p) => `
              <div class="lc-people-item">
                <div>
                  <div class="lc-people-who">${escapeHtml(p.who)}</div>
                  <div class="lc-people-note">${escapeHtml(p.note)}</div>
                </div>
                ${p.cost ? `<div class="lc-people-cost">${escapeHtml(p.cost)}</div>` : `<div class="lc-people-cost lc-people-cost-free">Free</div>`}
              </div>`).join('')}
          </div>
          <div class="lc-people-total-row">
            <div class="lc-people-total">Total people investment: <span>${escapeHtml(ppl.total)}</span></div>
            <div class="lc-people-truth">${escapeHtml(ppl.truth)}</div>
          </div>
        </div>`;
    }

    // Stress
    const stressEl = document.getElementById('lcResStress');
    if (stressEl) {
      stressEl.innerHTML = buildStressSection(spd);
    }

    // Phases — EDIT (step 7): month ranges are dynamic, derived from the speed
    // selection (total horizon = speedMonths). Phase 1 is always the first 30
    // days; phases 2-4 split the remaining runway into thirds.
    const phases = PHASES[arch ? arch.key : 'explorer'];
    const phaseEl = document.getElementById('lcResPhases');
    if (phaseEl) {
      const M = speedMonths();
      phaseEl.innerHTML = phases.map((ph, i) => `
        <div class="lc-phase-card">
          <div class="lc-phase-top">
            <span class="lc-phase-badge">${ph.name} / ${ph.sub}</span>
            <span class="lc-phase-time">${phaseTime(i, M)}</span>
          </div>
          <div class="lc-phase-focus">${escapeHtml(ph.focus)}</div>
          <div class="lc-phase-tasks">
            ${ph.tasks.map((t) => `<div class="lc-phase-task">${escapeHtml(t)}</div>`).join('')}
          </div>
        </div>`).join('');
    }

    // EDIT (step 7): Lifestyle Protocol — content + intensity tiers pending.
    // Kept hidden until that copy is provided (see lcResProtocolWrap).
    renderProtocol();

    // Mind mines
    const minesEl = document.getElementById('lcResMines');
    const warnEl = document.getElementById('lcResWarning');
    if (minesEl && warnEl) {
      if (state.mines.length === 0) {
        minesEl.innerHTML = '';
        warnEl.innerHTML = '';
      } else {
        const items = state.mines.map((mk) => {
          const m = MINES.find((x) => x.key === mk);
          if (!m) return '';
          return `
            <div class="lc-mine-result-item">
              <div class="lc-mine-result-name">${m.label}</div>
              <div class="lc-mine-result-stat">${m.stat}</div>
              <div class="lc-mine-result-fix">${m.fix}</div>
            </div>`;
        }).join('');
        minesEl.innerHTML = `
          <div class="lc-mine-result-card">
            <span class="lc-mine-result-badge">MIND MINES, ${state.mines.length} ACTIVE BLOCK${state.mines.length > 1 ? 'S' : ''} IDENTIFIED</span>
            ${items}
          </div>`;
        if (state.mines.includes('money') || state.mines.includes('visibility')) {
          warnEl.innerHTML = `<div class="lc-warning-card"><p>A money ceiling or fear of visibility will stall your acquisition before the strategy gets a chance to work. This is the first block to address, not the last.</p></div>`;
        } else {
          warnEl.innerHTML = '';
        }
      }
    }
  }

  // Phase time labels derived from the total speed horizon M (months).
  // Phase 1 = first 30 days; phases 2-4 split the remaining runway in thirds.
  function phaseTime(i: number, M: number): string {
    if (i === 0) return 'Days 1 to 30';
    const lo = i === 1 ? 1 : Math.round((M / 3) * (i - 1));
    const hi = i === 3 ? M : Math.round((M / 3) * i);
    return `Month ${lo} to ${hi}`;
  }

  // Lifestyle Protocol (step 7) — copy + intensity-by-revenue-goal tiers pending.
  // Until provided, the section stays hidden. When you send the copy, populate
  // #lcResProtocol here and remove the `hidden` attribute on #lcResProtocolWrap.
  function renderProtocol(): void {
    const wrap = document.getElementById('lcResProtocolWrap');
    if (wrap) wrap.setAttribute('hidden', '');
  }

  function buildStressSection(spd: SpeedKey): string {
    const mineCount = state.mines.length;
    const baseStress = { turtle: 5.5, car: 6.5, rocket: 8 }[spd];
    const stressSolo = Math.min(10, baseStress + mineCount * 0.5);
    const stressSupported = Math.max(2, stressSolo * 0.42);
    const soloW = Math.round(stressSolo * 10);
    const suppW = Math.round(stressSupported * 10);
    const t = SPEED_TIME_LABELS[spd];

    const burnSolo = spd === 'rocket' ? 'Very High' : spd === 'car' ? 'Moderate' : 'Low to Moderate';
    const burnSupp = spd === 'rocket' ? 'Managed' : 'Low';

    return `
      <div class="lc-stress-section">
        <div class="lc-stress-header">
          <span class="lc-res-badge">STRESS REALITY</span>
          <div class="lc-res-val lc-stress-val-head">Doing it alone vs. with the right people at the right time</div>
        </div>
        <div class="lc-stress-cols">
          <div>
            <span class="lc-stress-col-label lc-solo-label">GOING SOLO</span>
            ${stressRow('Stress level', stressSolo.toFixed(1) + '/10', soloW, 'lc-solo-fill')}
            ${stressRow('Time to goal', t.solo, Math.round(soloW * 0.75), 'lc-solo-fill')}
            ${stressRow('Risk of burnout', burnSolo, soloW - 10, 'lc-solo-fill')}
            ${stressRow('Mistake tax', 'Paid in time + money', Math.round(soloW * 0.8), 'lc-solo-fill')}
          </div>
          <div>
            <span class="lc-stress-col-label lc-supp-label">WITH RIGHT PEOPLE</span>
            ${stressRow('Stress level', stressSupported.toFixed(1) + '/10', suppW, 'lc-supp-fill')}
            ${stressRow('Time to goal', t.supported, Math.round(suppW * 0.75), 'lc-supp-fill')}
            ${stressRow('Risk of burnout', burnSupp, suppW - 5, 'lc-supp-fill')}
            ${stressRow('Mistake tax', 'Paid in investment instead', Math.round(suppW * 0.8), 'lc-supp-fill')}
          </div>
        </div>
        <div class="lc-stress-note">On average, founders working with structured mentorship and community reach their first client 2 to 3x faster and report significantly lower decision anxiety and burnout markers.</div>
      </div>`;
  }

  function stressRow(name: string, val: string, widthPct: number, fillClass: string): string {
    const w = Math.min(100, Math.max(5, widthPct));
    return `
      <div class="lc-stress-metric">
        <div class="lc-stress-metric-name">${name}</div>
        <div class="lc-stress-bar-track"><div class="lc-stress-bar-fill ${fillClass}" style="width:${w}%"></div></div>
        <div class="lc-stress-val">${val}</div>
      </div>`;
  }

  // ── Restore UI from state ──────────────────────────────
  function restoreUi(): void {
    if (state.ideaCategory) {
      const tile = document.querySelector<HTMLElement>(`.lc-cat-tile[data-cat="${state.ideaCategory}"]`);
      if (tile) tile.classList.add('is-selected');
    }
    if (state.archetype) {
      const ac = document.querySelector(`.lc-arch-card[data-arch="${state.archetype}"]`);
      if (ac) ac.classList.add('is-selected');
    }
    if (state.speed) {
      const sc = document.querySelector(`.lc-speed-card[data-speed="${state.speed}"]`);
      if (sc) sc.classList.add('is-selected');
    }
    if (state.monthlyGoal)  (document.getElementById('lc-monthly-goal') as HTMLInputElement).value = String(state.monthlyGoal);
    if (state.offerPrice)   (document.getElementById('lc-offer-price') as HTMLInputElement).value = String(state.offerPrice);
    if (state.s2l !== 1)    (document.getElementById('lc-s2l-rate') as HTMLInputElement).value = String(state.s2l);
    if (state.l2s !== 20)   (document.getElementById('lc-l2s-rate') as HTMLInputElement).value = String(state.l2s);

    state.mines.forEach((mk) => {
      const item = document.querySelector(`.lc-mine-item[data-mine="${mk}"]`);
      if (item) item.classList.add('is-selected');
    });
  }

  // ── Save the map (replaces "Email me my map") ──────────
  // STUB (step 7, item d): exact behavior TBC. Default = browser print/save
  // dialog (print-ready, no email). Swap for a downloadable export if preferred.
  // Build a clean, linear, print-only report from the SAME data the on-screen
  // results use. The interactive layout (absolute phase-timeline circles,
  // reveal transforms, dark cards) does not linearise for print, so we render
  // a purpose-built document instead and print only that (see @media print).
