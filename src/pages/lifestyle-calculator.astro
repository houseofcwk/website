  /* ── Step 3: Speed ─────────────────────────────────── */
  .lc-speed-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 32px; }
  .lc-speed-card {
    padding: 22px 16px 18px;
    cursor: pointer; text-align: left;
    border-radius: 14px;
    color: inherit; font: inherit; position: relative;
    display: flex; flex-direction: column;
    transition: all 0.2s ease; overflow: hidden;
  }
  .lc-speed-card::after {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    opacity: 0; transition: opacity 0.25s;
  }
  .lc-speed-turtle::after { background: #00E396; }
  .lc-speed-car::after    { background: var(--cyan); }
  .lc-speed-rocket::after { background: var(--pink); }
  .lc-speed-card:hover { background: rgba(255,255,255,0.05); border-color: var(--gb2); }
  .lc-speed-card:hover::after { opacity: 1; }
  .lc-speed-card.is-selected::after { opacity: 1; }
  .lc-speed-turtle.is-selected { border-color: #00E396;     background: rgba(0, 227, 150, 0.05); }
  .lc-speed-car.is-selected    { border-color: var(--cyan); background: rgba(0, 229, 255, 0.05); }
  .lc-speed-rocket.is-selected { border-color: var(--pink); background: rgba(251, 48, 121, 0.05); }
  .lc-speed-symbol { display: block; margin-bottom: 12px; line-height: 1; }
  .lc-speed-turtle .lc-speed-symbol { color: #00E396; }
  .lc-speed-car .lc-speed-symbol    { color: var(--cyan); }
  .lc-speed-rocket .lc-speed-symbol { color: var(--pink); }
  .lc-speed-label { display: block; font-size: 15px; font-weight: 800; color: var(--text); margin-bottom: 6px; }
  .lc-speed-time {
    display: block; font-size: 10px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    margin-bottom: 10px;
  }
  .lc-speed-turtle .lc-speed-time { color: #00E396; }
  .lc-speed-car .lc-speed-time    { color: var(--cyan); }
  .lc-speed-rocket .lc-speed-time { color: var(--pink); }
  .lc-speed-desc { display: block; font-size: 12px; color: var(--muted); line-height: 1.65; flex: 1; }
  .lc-speed-check {
    position: absolute; top: 12px; right: 12px;
    width: 18px; height: 18px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 900;
    opacity: 0; transform: scale(0.4); transition: all 0.2s ease;
  }
  .lc-speed-turtle.is-selected .lc-speed-check { opacity: 1; transform: scale(1); background: #00E396;     color: var(--bg); }
  .lc-speed-car.is-selected .lc-speed-check    { opacity: 1; transform: scale(1); background: var(--cyan); color: var(--bg); }
  .lc-speed-rocket.is-selected .lc-speed-check { opacity: 1; transform: scale(1); background: var(--pink); color: #fff; }

  /* ── Step 4: Funnel ────────────────────────────────── */
  .lc-funnel-top { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 4px; }
  .lc-funnel-card { padding: 18px 20px; }
  .lc-funnel-num {
    font-size: 32px; font-weight: 800; color: var(--cyan);
    letter-spacing: -0.025em; line-height: 1; margin-bottom: 6px;
  }
  .lc-funnel-lbl {
    font-size: 10px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--dim);
  }
  .lc-funnel-arrows { display: flex; margin: 4px 0; }
  .lc-funnel-arrows span { flex: 1; text-align: center; font-size: 12px; color: var(--dim); }
  .lc-funnel-bottom { margin-bottom: 4px; }
  .lc-funnel-total {
    border-color: rgba(0, 229, 255, 0.22);
    background: rgba(0, 229, 255, 0.04);
    display: flex; align-items: center; gap: 22px; padding: 22px 22px;
  }
  .lc-funnel-total-num {
    font-size: 40px; font-weight: 800; color: var(--cyan);
    letter-spacing: -0.03em; line-height: 1; white-space: nowrap;
  }
  .lc-funnel-total-meta { flex: 1; }
  .lc-funnel-total-meta p {
    font-size: 13px; color: var(--muted);
    line-height: 1.6; margin: 4px 0 0;
  }

  .lc-divider { border: none; border-top: 1px solid var(--gb); margin: 28px 0; }

  .lc-adjust-block { padding: 20px 22px; }
  .lc-adjust-title {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    font-size: 10px; font-weight: 700; letter-spacing: 0.28em;
    text-transform: uppercase; color: var(--dim); margin-bottom: 16px;
  }
  .lc-adjust-optional {
    display: inline-block;
    padding: 3px 8px;
    background: rgba(0, 229, 255, 0.10);
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 4px;
    font-size: 9px; font-weight: 800; letter-spacing: 0.22em;
    color: var(--cyan);
    line-height: 1;
  }
  .lc-adjust-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lc-adjust-field { display: flex; flex-direction: column; gap: 7px; }
  .lc-adjust-field label {
    font-size: 10px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--dim);
  }
  .lc-adjust-field input {
    background: var(--bg2);
    border: 1px solid var(--gb);
    border-radius: 8px;
    color: var(--text); font-family: inherit;
    font-size: 15px; font-weight: 600;
    padding: 11px 14px; outline: none;
    transition: border-color 0.2s;
  }
  .lc-adjust-field input:focus { border-color: rgba(0, 229, 255, 0.45); }

  /* ── Step 5: Mind mines ────────────────────────────── */
  .lc-mine-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 32px; }
  .lc-mine-item {
    cursor: pointer; transition: all 0.2s; overflow: hidden; padding: 0;
  }
  .lc-mine-item:hover { background: rgba(255,255,255,0.05); border-color: var(--gb2); }
  .lc-mine-item.is-selected { border-color: rgba(251, 48, 121, 0.4); background: rgba(251, 48, 121, 0.04); }
  .lc-mine-stat-bar {
    background: rgba(251, 48, 121, 0.08);
    border-bottom: 1px solid rgba(251, 48, 121, 0.15);
    padding: 7px 18px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--pink);
    display: none;
  }
  .lc-mine-item.is-selected .lc-mine-stat-bar { display: block; }
  .lc-mine-body { display: flex; align-items: flex-start; gap: 14px; padding: 16px 18px; }
  .lc-mine-check {
    width: 20px; height: 20px;
    border: 1px solid var(--gb2); border-radius: 5px;
    flex-shrink: 0; margin-top: 2px;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; color: transparent; transition: all 0.15s;
  }
  .lc-mine-item.is-selected .lc-mine-check {
    background: var(--pink); border-color: var(--pink); color: #fff;
  }
  .lc-mine-content { flex: 1; }
  .lc-mine-label { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
  .lc-mine-desc { font-size: 12px; color: var(--muted); line-height: 1.65; }
  .lc-mine-fix {
    font-size: 11px; font-style: italic; color: var(--dim);
    margin-top: 8px; line-height: 1.6; display: none;
  }
  .lc-mine-item.is-selected .lc-mine-fix { display: block; color: rgba(238, 240, 255, 0.5); }

  /* ── Nav row ───────────────────────────────────────── */
  .lc-nav-row { display: flex; gap: 10px; margin-top: 32px; align-items: center; }
  .lc-btn-next {
    flex: 1;
    background: linear-gradient(135deg, var(--cyan), var(--purple));
    border: none; border-radius: 8px;
    color: var(--bg); font: inherit;
    font-size: 14px; font-weight: 700;
    padding: 14px 28px; cursor: pointer;
    transition: filter 0.2s, transform 0.15s;
    letter-spacing: 0.01em;
  }
  .lc-btn-next:hover  { filter: brightness(1.1); transform: translateY(-1px); }
  .lc-btn-next:active { transform: scale(0.98); }
  .lc-btn-back {
    background: transparent;
    border: 1px solid var(--gb);
    border-radius: 8px;
    color: var(--muted); font: inherit;
    font-size: 14px; font-weight: 500;
    padding: 14px 22px; cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .lc-btn-back:hover { border-color: var(--gb2); color: var(--text); }

  /* ── Flash (validation prompt) ─────────────────────── */
  .lc-flash {
    outline: 1px solid rgba(251, 48, 121, 0.6) !important;
    border-radius: 12px;
  }

  /* ── Section labels in results ─────────────────────── */
  .lc-section-label {
    display: block;
    font-size: 11px; font-weight: 700; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--cyan);
    margin: 0 0 14px;
  }
  /* Reveal direct sections of the result step uniformly. The first
     direct child after the heading gets reduced top-margin so the
     hero card sits closer to the title. */
  #lc-step-6 .lc-reveal { margin-top: 44px; }
  #lc-step-6 .lc-reveal:first-of-type { margin-top: 0; }

  /* Reveal-on-enter animation — staggered by IntersectionObserver. */
  #lc-step-6 .lc-reveal {
    opacity: 0; transform: translateY(14px);
    transition: opacity 520ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }
  #lc-step-6 .lc-reveal.is-revealed {
    opacity: 1; transform: none;
  }

  /* ── Hero stats card (player header) ───────────────── */
  .lc-player-header {
    background: linear-gradient(180deg, rgba(0, 229, 255, 0.06) 0%, rgba(123, 97, 255, 0.04) 100%), rgba(11, 14, 24, 0.85);
    border: 1px solid rgba(0, 229, 255, 0.24);
    border-radius: 22px;
    padding: 36px 36px 32px;
    position: relative; overflow: hidden;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.45),
                inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  .lc-player-header::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--cyan), var(--purple));
  }
  .lc-player-header::after {
    content: ''; position: absolute; right: -120px; top: -80px;
    width: 320px; height: 320px; border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 97, 255, 0.18), transparent 60%);
    pointer-events: none;
  }
  .lc-player-badges {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin-bottom: 18px; position: relative;
  }
  .lc-player-badge {
    font-size: 10px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; border-radius: 999px;
    padding: 5px 12px; border: 1px solid;
  }
  .lc-badge-mind   { color: var(--cyan);   background: rgba(0, 229, 255, 0.1);   border-color: rgba(0, 229, 255, 0.25); }
  .lc-badge-body   { color: #00E396;       background: rgba(0, 227, 150, 0.1);   border-color: rgba(0, 227, 150, 0.25); }
  .lc-badge-soul   { color: var(--purple); background: rgba(123, 97, 255, 0.1);  border-color: rgba(123, 97, 255, 0.25); }
  .lc-badge-pocket { color: var(--pink);   background: rgba(251, 48, 121, 0.1);  border-color: rgba(251, 48, 121, 0.25); }
  .lc-badge-creative { color: var(--cyan);   background: rgba(0, 229, 255, 0.1);  border-color: rgba(0, 229, 255, 0.25); }
  .lc-badge-business { color: var(--purple); background: rgba(123, 97, 255, 0.1); border-color: rgba(123, 97, 255, 0.25); }
  .lc-badge-other    { color: #00E396;       background: rgba(0, 227, 150, 0.1);  border-color: rgba(0, 227, 150, 0.25); }

  /* EDIT (step 7): generic recommended-tools rows */
  .lc-tool-rows { display: flex; flex-direction: column; gap: 2px; margin: 4px 0 14px; }
  .lc-tool-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    padding: 10px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .lc-tool-row:last-child { border-bottom: none; }
  .lc-tool-row-label { font-size: 14px; color: var(--text); }
  .lc-tool-row-price { font-size: 13px; color: var(--muted); white-space: nowrap; }

  /* EDIT (step 7): Save the map */
  .lc-savemap { text-align: center; margin: 8px 0 4px; }
  .lc-savemap-btn {
    background: rgba(255, 255, 255, 0.04); color: var(--text);
    border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 10px;
    padding: 13px 26px; font-size: 14px; font-weight: 600; cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .lc-savemap-btn:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(0, 229, 255, 0.4); }
  .lc-savemap-note { margin: 10px 0 0; font-size: 12px; color: var(--muted); }
  .lc-badge-stage  { color: var(--cyan);   background: rgba(0, 229, 255, 0.06);  border-color: rgba(0, 229, 255, 0.28); }
  .lc-player-headline {
    font-size: 22px; font-weight: 700; color: var(--text);
    margin-bottom: 28px; line-height: 1.35; letter-spacing: -0.012em;
    position: relative;
    overflow-wrap: break-word;
  }
  .lc-player-headline span { color: var(--cyan); font-weight: 800; }
  .lc-player-stats {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 0; position: relative;
  }
  .lc-stat-cell {
    padding: 8px 24px 8px 0;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    background: transparent; border-radius: 0;
  }
  .lc-stat-cell:last-child { border-right: none; padding-right: 0; }
  .lc-player-stats .lc-stat-cell + .lc-stat-cell { padding-left: 24px; }
  .lc-stat-val {
    font-size: 44px; font-weight: 800; color: var(--text);
    letter-spacing: -0.03em; line-height: 1; margin-bottom: 8px;
    font-feature-settings: "tnum" 1;
  }
  .lc-stat-lbl {
    font-size: 10px; font-weight: 700; letter-spacing: 0.28em;
    text-transform: uppercase; color: var(--muted);
  }

  /* ── Now-vs-Goal 2-col compare ─────────────────────── */
  .lc-now-goal {
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
  }
  .lc-now-goal-col { display: flex; flex-direction: column; }
  .lc-now-goal-col .lc-section-label { color: var(--pink); }
  .lc-now-goal-goal .lc-section-label { color: #00E396; }
  .lc-now-goal-col > div { flex: 1; }

  /* ── Result cards ──────────────────────────────────── */
  .lc-res-card {
    padding: 24px 24px;
    border-radius: 14px;
    height: 100%;
    border-left: 3px solid #00E396;
  }
  .lc-res-badge {
    display: block;
    font-size: 10px; font-weight: 700; letter-spacing: 0.28em;
    text-transform: uppercase; color: #00E396; margin-bottom: 12px;
  }
  .lc-res-val { font-size: 24px; font-weight: 800; color: var(--text); margin-bottom: 10px; line-height: 1.2; letter-spacing: -0.015em; }
  .lc-res-desc { font-size: 14px; color: var(--muted); line-height: 1.7; }

  /* Archetype snapshot — sits in the now column */
  .lc-arch-snapshot {
    background: rgba(251, 48, 121, 0.04);
    border: 1px solid rgba(251, 48, 121, 0.18);
    border-left: 3px solid var(--pink);
    border-radius: 14px;
    padding: 24px 24px;
    height: 100%;
  }
  .lc-arch-snap-tag {
    font-size: 10px; font-weight: 700; letter-spacing: 0.28em;
    text-transform: uppercase; color: var(--pink);
    display: block; margin-bottom: 12px;
  }
  .lc-arch-snap-name { font-size: 24px; font-weight: 800; color: var(--text); margin-bottom: 10px; letter-spacing: -0.015em; line-height: 1.2; }
  .lc-arch-snap-feel { font-size: 14px; color: var(--muted); line-height: 1.7; }

  /* Timeline */
  .lc-timeline-card { padding: 20px 22px; }
  .lc-timeline-row {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 10px 0; border-bottom: 1px solid var(--gb);
  }
  .lc-timeline-row:last-child { border-bottom: none; padding-bottom: 0; }
  .lc-timeline-marker {
    width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 800; color: var(--bg);
  }
  .lc-timeline-when { font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin-bottom: 3px; }
  .lc-timeline-what { font-size: 13px; font-weight: 600; color: var(--text); line-height: 1.4; }

  /* Tools */
  .lc-breakdown-card { padding: 20px 22px; }
  .lc-breakdown-title {
    display: block;
    font-size: 9px; font-weight: 700; letter-spacing: 0.36em;
    text-transform: uppercase; color: var(--cyan); margin-bottom: 14px;
  }
  .lc-tool-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .lc-tool-pill {
    font-size: 11px; font-weight: 600;
    background: rgba(0, 229, 255, 0.07);
    border: 1px solid rgba(0, 229, 255, 0.2);
    border-radius: 100px;
    padding: 5px 12px; color: var(--muted);
  }
  .lc-tool-cost { margin-top: 12px; font-size: 11px; color: var(--dim); }
  .lc-tool-cost span { color: var(--muted); font-weight: 600; }

  /* Skills */
  .lc-skill-list { display: flex; flex-direction: column; gap: 8px; }
  .lc-skill-item { display: flex; align-items: flex-start; gap: 10px; }
  .lc-skill-num {
    font-size: 9px; font-weight: 800; min-width: 18px; height: 18px;
    background: rgba(0, 229, 255, 0.1);
    border: 1px solid rgba(0, 229, 255, 0.2);
    border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    color: var(--cyan); flex-shrink: 0; margin-top: 1px;
  }
  .lc-skill-text { font-size: 12.5px; color: var(--muted); line-height: 1.65; }

  /* People */
  .lc-people-list { display: flex; flex-direction: column; gap: 10px; }
  .lc-people-item { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .lc-people-who { font-size: 12.5px; font-weight: 600; color: var(--text); margin-bottom: 2px; }
  .lc-people-note { font-size: 11.5px; color: var(--muted); line-height: 1.5; }
  .lc-people-cost { font-size: 10px; font-weight: 700; color: #00E396; white-space: nowrap; margin-top: 2px; }
  .lc-people-cost-free { color: var(--dim); }
  .lc-people-total-row { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--gb); }
  .lc-people-total { font-size: 11.5px; font-weight: 700; color: var(--muted); margin-bottom: 6px; }
  .lc-people-total span { color: var(--cyan); }
  .lc-people-truth { font-size: 11px; color: var(--dim); line-height: 1.65; font-style: italic; }

  /* Stress */
  .lc-stress-section { padding: 22px; }
  .lc-stress-header { margin-bottom: 18px; }
  .lc-stress-val-head { font-size: 15px; }
  .lc-stress-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .lc-stress-col-label {
    display: block;
    font-size: 10px; font-weight: 700; letter-spacing: 0.28em;
    text-transform: uppercase; margin-bottom: 14px;
  }
  .lc-solo-label { color: var(--dim); }
  .lc-supp-label { color: var(--cyan); }
  .lc-stress-metric { margin-bottom: 12px; }
  .lc-stress-metric-name {
    font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--dim); margin-bottom: 6px;
  }
  .lc-stress-bar-track {
    height: 6px; background: rgba(255, 255, 255, 0.06);
    border-radius: 3px; overflow: hidden; margin-bottom: 4px;
  }
  .lc-stress-bar-fill { height: 100%; border-radius: 3px; transition: width 0.8s ease; }
  .lc-solo-fill { background: rgba(255, 120, 50, 0.6); }
  .lc-supp-fill { background: #00E396; }
  .lc-stress-val { font-size: 11px; font-weight: 700; color: var(--muted); }
  .lc-stress-note {
    margin-top: 16px; padding-top: 16px;
    border-top: 1px solid var(--gb);
    font-size: 12px; color: var(--dim); line-height: 1.7;
    font-style: italic; text-align: center;
  }

  /* Phase roadmap — horizontal 4-step grid that breaks out of the
     760px content wrap so cards have room to breathe. The
     numbered circles still anchor each phase; no connecting line. */
  .lc-phase-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
    position: relative;
    counter-reset: phase;
    /* Break out of .lc-wrap (760px max) to ~1180px on wide screens.
       Stays visually centered via translateX(-50%). */
    width: min(1180px, calc(100vw - 32px));
    left: 50%;
    transform: translateX(-50%);
  }
  .lc-phase-card {
    padding: 36px 22px 24px;
    position: relative; overflow: visible;
    counter-increment: phase;
    text-align: left;
  }
  .lc-phase-card::before {
    content: counter(phase);
    position: absolute; top: -2px; left: 50%; transform: translate(-50%, -50%);
    width: 40px; height: 40px; border-radius: 50%;
    background: linear-gradient(135deg, var(--cyan), var(--purple));
    color: var(--bg);
    font-size: 14px; font-weight: 800; letter-spacing: -0.02em;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 4px var(--bg), 0 6px 18px rgba(0, 229, 255, 0.28);
    z-index: 1;
  }
  .lc-phase-top {
    display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
    margin-bottom: 14px;
  }
  .lc-phase-badge {
    font-size: 10px; font-weight: 700; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--pink);
    line-height: 1.4;
  }
  .lc-phase-time {
    font-size: 10px; font-weight: 600; letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--gb);
    border-radius: 999px; padding: 3px 10px; color: var(--dim);
    white-space: nowrap;
  }
