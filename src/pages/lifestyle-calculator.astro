        <div class="lcp-phase">
          <div class="lcp-phase-head"><span class="lcp-phase-name">${escapeHtml(ph.name)} / ${escapeHtml(ph.sub)}</span><span class="lcp-phase-time">${phaseTime(i, M)}</span></div>
          <div class="lcp-phase-focus">${escapeHtml(ph.focus)}</div>
          <ul class="lcp-list">${ph.tasks.map((x) => `<li>${escapeHtml(x)}</li>`).join('')}</ul>
        </div>`,
      )
      .join('');

    const toolsHtml = `<table class="lcp-table"><tbody>${RECOMMENDED_TOOLS.map(
      (tl) => `<tr><td>${escapeHtml(tl.label)}</td><td class="lcp-r">${escapeHtml(tl.price)}</td></tr>`,
    ).join('')}<tr class="lcp-total"><td>Estimated total</td><td class="lcp-r">${escapeHtml(RECOMMENDED_TOOLS_TOTAL)}</td></tr></tbody></table>`;

    const skillsHtml = `<ol class="lcp-ol">${skillList.map((s) => `<li>${escapeHtml(s)}</li>`).join('')}</ol>`;

    const peopleHtml = `<table class="lcp-table"><tbody>${ppl.list
      .map(
        (p) =>
          `<tr><td><strong>${escapeHtml(p.who)}</strong><br><span class="lcp-muted">${escapeHtml(p.note)}</span></td><td class="lcp-r">${escapeHtml(p.cost || 'Free')}</td></tr>`,
