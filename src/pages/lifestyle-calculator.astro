      .join('')}<tr class="lcp-total"><td>Total people investment</td><td class="lcp-r">${escapeHtml(ppl.total)}</td></tr></tbody></table><p class="lcp-muted">${escapeHtml(ppl.truth)}</p>`;

    const stressHtml = `<table class="lcp-table"><thead><tr><th></th><th class="lcp-r">Going solo</th><th class="lcp-r">With right people</th></tr></thead><tbody>
      <tr><td>Stress level</td><td class="lcp-r">${stressSolo.toFixed(1)}/10</td><td class="lcp-r">${stressSupported.toFixed(1)}/10</td></tr>
      <tr><td>Time to goal</td><td class="lcp-r">${escapeHtml(t.solo)}</td><td class="lcp-r">${escapeHtml(t.supported)}</td></tr>
      <tr><td>Risk of burnout</td><td class="lcp-r">${burnSolo}</td><td class="lcp-r">${burnSupp}</td></tr>
      <tr><td>Mistake tax</td><td class="lcp-r">Paid in time + money</td><td class="lcp-r">Paid in investment</td></tr>
    </tbody></table>`;

    const minesHtml = state.mines.length
      ? `<ul class="lcp-mines">${state.mines
          .map((mk) => {
            const m = MINES.find((x) => x.key === mk);
            return m
              ? `<li><strong>${escapeHtml(m.label)}</strong> — ${escapeHtml(m.stat)}<br><span class="lcp-muted">${escapeHtml(m.fix)}</span></li>`
              : '';
          })
          .join('')}</ul>`
      : '<p class="lcp-muted">No blocks flagged.</p>';

    host.innerHTML = `
      <div class="lcp-doc">
        <header class="lcp-header">
          <div class="lcp-brand">CWK. <span>Lifestyle Map</span></div>
          <div class="lcp-metaline">${escapeHtml(catLabel || 'Your service')}${arch ? ` · ${escapeHtml(arch.tag)} / ${escapeHtml(arch.name)}` : ''}</div>
        </header>
        <h1 class="lcp-title">A ${arch ? escapeHtml(arch.name) : 'founder'} running ${escapeHtml(catLabel || 'your service')}, targeting $${fmtK(state.monthlyGoal)}/month.</h1>

        ${sec(
          'Your target',
          `<div class="lcp-target">$${fmt(state.monthlyGoal)} / month</div>
          <p class="lcp-p">That is $${fmt(state.monthlyGoal * 12)}/year. At $${fmt(state.offerPrice)} per offer you need <strong>${fmt(n.totalSales)} sales</strong> over ${state.timeMonths} months, ${salesCad.prose}. To close those you need to reach <strong>${fmt(n.strangersPw)} brand-new people</strong> every week.</p>
          <div class="lcp-stats">
            <div class="lcp-stat"><span>${fmt(n.strangersPw)}</span>New people / week</div>
            <div class="lcp-stat"><span>${fmt(n.leadsPw)}</span>Leads / week</div>
            <div class="lcp-stat"><span>${salesCad.num}</span>${escapeHtml(salesCad.lbl)}</div>
            <div class="lcp-stat"><span>${fmt(n.totalSales)}</span>Total sales · ${state.timeMonths} mo</div>
          </div>`,
        )}
        ${sec('Your phase roadmap', phasesHtml)}
        ${skillList.length ? sec('What to learn, in order', skillsHtml) : ''}
        ${sec('Recommended tools', toolsHtml)}
        ${sec('People you need, at your speed', peopleHtml)}
        ${sec('Stress reality', stressHtml)}
        ${sec('Mind mines — blocks to clear', minesHtml)}

        <footer class="lcp-footer">cwkexperience.com &nbsp;·&nbsp; Build. Learn. Earn. Play.</footer>
      </div>`;
  }

  function handleSaveMap(): void {
    track('lc_save_map', { category: state.ideaCategory, speed: state.speed });
    renderPrintReport();
    window.print();
  }

  // ── Wire it all up ─────────────────────────────────────
  const stateExisted = (() => {
    try { return Boolean(localStorage.getItem(STORAGE_KEY)); } catch { return false; }
  })();
  loadState();
  track('lc_started', {
    resumed: stateExisted,
    entry_step: currentStep,
  });
  document.querySelectorAll<HTMLButtonElement>('.lc-cat-tile').forEach((btn) => {
    btn.addEventListener('click', () => selectCat(btn.dataset.cat as CategoryKey, btn));
  });

  wireArchetypes();
  wireSpeeds();
  wireMines();

  const STEP_NAMES = ['category', 'archetype', 'prize', 'speed', 'bridges', 'mines'];

  document.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const step = parseInt(btn.dataset.next ?? '0', 10);
      if (!validateStep(step)) return;
      const props: Record<string, string | number | boolean> = {
        step,
        step_name: STEP_NAMES[step] ?? `step_${step}`,
        time_on_step_ms: Date.now() - stepEnteredAt,
      };
      if (step === 2) {
        props.monthly_goal_bucket = bucketCurrency(state.monthlyGoal);
        props.offer_price_bucket = bucketCurrency(state.offerPrice);
      }
      if (step === 4) {
        props.s2l_pct = state.s2l;
        props.l2s_pct = state.l2s;
        props.defaults_changed = state.s2l !== 1 || state.l2s !== 20;
      }
      if (step === 5) {
        track('lc_mines_selected', {
          mines_active: state.mines.length,
          mine_keys: state.mines.slice(),
          none_selected: state.mines.length === 0,
        });
        props.mines_active = state.mines.length;
      }
      track('lc_step_completed', props);
      if (step + 1 === 6) {
        track('lc_map_revealed', {
          category: state.ideaCategory,
          archetype_key: state.archetype,
          speed: state.speed,
          monthly_goal_bucket: bucketCurrency(state.monthlyGoal),
          mines_active: state.mines.length,
        });
      }
      stepEnteredAt = Date.now();
      showStep(step + 1);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const step = parseInt(btn.dataset.back ?? '0', 10);
      showStep(Math.max(0, step - 1));
    });
  });

  // Live recalc on conversion-rate inputs
  ['lc-s2l-rate', 'lc-l2s-rate'].forEach((id) => {
    const el = document.getElementById(id) as HTMLInputElement | null;
    el?.addEventListener('input', () => {
      state.s2l = parseFloat((document.getElementById('lc-s2l-rate') as HTMLInputElement).value) || 1;
      state.l2s = parseFloat((document.getElementById('lc-l2s-rate') as HTMLInputElement).value) || 20;
      renderFunnel();
      saveState();
    });
  });

  document.getElementById('lcPathBBtn')?.addEventListener('click', () => {
    track('lc_path_b_clicked', {
      archetype_key: state.archetype,
      category: state.ideaCategory,
    });
  });
  document.getElementById('lcPathABtn')?.addEventListener('click', () => {
    conversion('lc_path_a_clicked', {
      archetype_key: state.archetype,
      category: state.ideaCategory,
      speed: state.speed,
    });
  });
  document.getElementById('lcSaveMapBtn')?.addEventListener('click', handleSaveMap);

  // Restore UI from saved state, then jump to the saved step
  restoreUi();
  showStep(currentStep);
</script>

<!-- ── EPIC auth-monetization (#220): one-free-run-then-pay gate ─────────────
     Self-contained module: works off the DOM + localStorage + PLOS APIs, so it
     needs no access to the calculator script's internals. -->
<script>
  import { me } from '../lib/plosAuth';
  import { getFeatures, claimCheckout, mapCompleted } from '../lib/plosEntitlements';
  import { track, conversion } from '../lib/analytics';

  const FEATURE = 'lifestyle-calculator';
  const LANDING = '/lifestyle-calculator/unlock';

  // When the user reaches the report (#lc-step-6 active), ping the server once
  // so it can schedule the day-3 follow-up email.
  function watchMapCompletion(): void {
    const step6 = document.getElementById('lc-step-6');
    if (!step6) return;
    let pinged = false;
    const fire = () => {
      if (!pinged && step6.classList.contains('is-active')) {
        pinged = true;
        void mapCompleted();
      }
    };
    new MutationObserver(fire).observe(step6, { attributes: true, attributeFilter: ['class'] });
    fire();
  }

  function currentUrlClean(): string {
    const u = new URL(window.location.href);
    u.searchParams.delete('checkout');
    u.searchParams.delete('auth_error');
    u.searchParams.delete('session_id');
    return u.toString();
  }

  // ── Access gate ──────────────────────────────────────────────────────────
  // Model: PAID TO TRY. The calculator tool lives here; non-paid (non-admin)
  // visitors are redirected to the landing page (/lifestyle-calculator/unlock)
  // which sells + handles checkout. A full-screen veil hides the tool until
  // access is resolved, so non-paid users never see a flash of the calculator.
  function revealTool(): void {
    const veil = document.getElementById('lc-gate-veil');
    if (veil) veil.setAttribute('hidden', '');
    watchMapCompletion();
  }
  function redirectToLanding(): void {
    window.location.replace(LANDING);
  }

  (async () => {
    const params = new URL(window.location.href).searchParams;
    const checkout = params.get('checkout');

    const auth = await me();
    if (auth.authenticated && auth.user?.isAdmin) {
      if (checkout) history.replaceState(null, '', currentUrlClean());
      revealTool();
      return; // admin bypass
    }

    if (checkout === 'success') {
      // Payment-first auto-login: claim the Stripe session → server provisions
      // the buyer, grants the entitlement, and sets the session cookie.
      const sessionId = params.get('session_id');
      if (sessionId) await claimCheckout(sessionId).catch(() => undefined);
      // Confirm entitlement (claim is sync; poll as a fallback for webhook lag).
      for (let i = 0; i < 6; i += 1) {
        if ((await getFeatures()).includes(FEATURE)) {
          track('lc_paid', {});
          conversion('lc_paid', {});
          history.replaceState(null, '', currentUrlClean());
          revealTool();
          return;
        }
        await new Promise((r) => setTimeout(r, 1200));
      }
    }

    if ((await getFeatures()).includes(FEATURE)) {
      revealTool();
      return; // paid
    }

    // Not admin, not paid → go sell on the landing page.
    redirectToLanding();
  })();
</script>

<style is:global>
