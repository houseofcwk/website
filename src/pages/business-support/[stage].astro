---
import Base from '../../layouts/Base.astro';
import '../../styles/business-support.css';

import JungleBackdrop from '../../components/business-support/JungleBackdrop.astro';
import StageVideo from '../../components/business-support/StageVideo.astro';
import LinkTree from '../../components/business-support/LinkTree.astro';

import { stages, TOUR_URL, type Stage } from '../../data/businessSupport';

// One page per stage, generated from src/data/businessSupport.ts:
//   /business-support/stage-one | stage-two | stage-three
//
// Shape is fixed: where you are, the training, then the three ways to reach
// a human. chrome="focus" removes the site nav and footer links, so the only
// ways off a stage page are the CWK. logo, the back link to the chooser, and
// the three options in the link tree. See #240.
export function getStaticPaths() {
  return stages.map((stage) => ({
    params: { stage: stage.key },
    props: { stage },
  }));
}

interface Props {
  stage: Stage;
}
const { stage } = Astro.props;
---

<Base
  title={stage.seoTitle}
  description={stage.seoDescription}
  canonical={`https://cwkexperience.com/business-support/${stage.key}`}
  chrome="focus"
  focusCta={{
    href: TOUR_URL,
    label: 'Book a Tour',
    // Opens the inline calendar further down this page rather than leaving it.
    openBooking: true,
  }}
>
  <div class={`bs bs-accent--${stage.accent}`} data-bs-stage={stage.key}>
    <JungleBackdrop still />

    <section class="bs-hero">
      <div class="bs-container">
        <a class="st-back" href="/business-support">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          All three stages
        </a>

        <div class="st-mark reveal-up">
          <span class="st-stage">Stage {stage.ordinal}</span>
          <span class="bs-progress" role="img" aria-label={`Stage ${stage.index} of ${stages.length}`}>
            {stages.map((s) => (
              <span class:list={['bs-progress-dot', { 'is-current': s.key === stage.key }]}></span>
            ))}
          </span>
        </div>

        <h1 class="bs-h1 bs-h1--sm reveal-up reveal-delay-1">{stage.headline}</h1>
        <p class="bs-lede reveal-up reveal-delay-2">{stage.lede}</p>
      </div>
    </section>

    <section class="bs-section">
      <div class="bs-container">
        <StageVideo
          videoId={stage.videoId}
          cover={stage.cover}
          caption={stage.caption}
          label={stage.videoTitle}
        />
      </div>
    </section>

    <section class="bs-section bs-section--last">
      <div class="bs-container">
        <div class="st-next reveal-up">
          <span class="bs-label">When you are ready</span>
          <span class="st-rule" aria-hidden="true"></span>
        </div>

        <LinkTree
          stageKey={stage.key}
          tourSub={stage.tourSub}
          whatsappMessage={stage.whatsappMessage}
        />
      </div>
    </section>
  </div>
</Base>

<script>
  import { track } from '../../lib/analytics';

  // The stage choice is recorded here rather than on the chooser's card click.
  // A click that navigates away is a race the page usually loses: the handler
  // fires, then the document is torn down before anything can be sent. Arrival
  // cannot be lost, and `from_chooser` reconstructs the same funnel step.
  const stage = document.querySelector<HTMLElement>('[data-bs-stage]')?.dataset.bsStage ?? '';
  let fromChooser = false;
  try {
    fromChooser = document.referrer
      ? new URL(document.referrer).pathname.replace(/index\.html$/, '').replace(/\/$/, '') ===
        '/business-support'
      : false;
  } catch { /* opaque or malformed referrer */ }

  track('business_support_stage_viewed', { stage, from_chooser: fromChooser });
</script>

<style>
  .st-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    /* 44px tall including the negative inset, so it stays a comfortable tap
       target without pushing the stage marker down the page. */
    margin: -12px 0 16px -12px;
    padding: 12px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s var(--bs-ease);
  }
  .st-back svg {
    width: 15px;
    height: 15px;
    transition: transform 0.2s var(--bs-ease);
  }
  @media (hover: hover) {
    .st-back:hover { color: var(--text); opacity: 1; }
    .st-back:hover svg { transform: translateX(-3px); }
  }
  .st-back:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 2px;
    border-radius: 8px;
  }

  .st-mark {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .st-stage {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bs-accent);
  }

  .st-next {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 20px;
  }
  .st-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gb2), transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .st-back, .st-back svg { transition: none; }
    .st-back:hover svg { transform: none; }
  }
</style>
