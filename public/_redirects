# Sanity Studio — SPA fallback. Every /studio/* subpath serves the Studio
# shell so Sanity's client router can take over without 404.
# Target must be a path Pages can resolve (/studio/ → /studio/index.html),
# not a literal "*.html" filename.
/studio/*                   /studio/                      200

