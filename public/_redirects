# Sanity Studio — SPA fallback. Every /studio/* subpath serves the Studio
# shell so Sanity's client router can take over without 404.
# Target must be a path Pages can resolve (/studio/ → /studio/index.html),
# not a literal "*.html" filename.
/studio/*                   /studio/                      200

# /work → /case-studies (route renamed)
/work                       /case-studies                 301
/work/*                     /case-studies/:splat          301

# /brand-mirror → /assessment (Brand Mirror retired)
/brand-mirror               /assessment                   301
/brand-mirror/*             /assessment                   301

# Legacy short links → canonical paths
/aboutkris                  /about                        301
/krisjourneyarticle         /about                        301
/flexlink                   /case-studies                 301
/thelabmiamicampusarticle   /case-studies/the-lab-miami   301
/robdialarticle             /case-studies/rob-dial        301
/spraycationmuraltour       /case-studies/spraycation     301
/dawaarticle                /case-studies/dawa            301
/stephyleearticle           /case-studies/stephy-lee      301
/raasininthesunarticle      /case-studies/raasin-in-the-sun  301
/beatstarsarticle           /case-studies/pay-the-creators   301
/lifestapestryarticle       /case-studies/lifes-tapestry  301
/brandmirrorlobby           /assessment                   301
/brandmirror                /assessment                   301

# Aliases for /business-support, which stays the canonical path: the pages
# carry canonical tags pointing at it and these are 301s, so the aliases never
# compete with it in search.
#
# /businesssupport is the one the printed QR codes encode
# (resources/design/qr/cwk-qr-business-support.png), so it has to keep working.
#
# The splat rules mirror the real structure, so /business/stage-two lands on
# that stage rather than dumping everyone back on the chooser.
/businesssupport            /business-support             301
/businesssupport/*          /business-support/:splat      301
/business                   /business-support             301
/business/*                 /business-support/:splat      301
